diff --git a/encoder/set.c b/encoder/set.c
index ec47193..0ed8ccb 100644
--- a/encoder/set.c
+++ b/encoder/set.c
@@ -169,14 +169,25 @@ void x264_sps_init( x264_sps_t *sps, int i_id, x264_param_t *param )
     sps->i_log2_max_frame_num = 4;
     while( (1 << sps->i_log2_max_frame_num) <= max_frame_num )
         sps->i_log2_max_frame_num++;
+    /* PMP-PSP compatibility: match XviD4PSP 5 reference SPS (log2_max_frame_num_minus4=5, pic_order_cnt_type=0) */
+    if( param->b_psp_compat )
+        sps->i_log2_max_frame_num = 9;
 
     sps->i_poc_type = param->i_bframe || param->b_interlaced || param->i_avcintra_class ? 0 : 2;
+    if( param->b_psp_compat && sps->i_poc_type == 2 )
+        sps->i_poc_type = 0;
     if( sps->i_poc_type == 0 )
     {
         int max_delta_poc = (param->i_bframe + 2) * (!!param->i_bframe_pyramid + 1) * 2;
         sps->i_log2_max_poc_lsb = 4;
         while( (1 << sps->i_log2_max_poc_lsb) <= max_delta_poc * 2 )
             sps->i_log2_max_poc_lsb++;
+        /* PMP-PSP compatibility: match XviD4PSP 5 reference SPS
+         * (log2_max_poc_lsb_minus4=6). x264's minimal window makes
+         * pic_order_cnt_lsb wrap every 8 frames; the PSP ME decoder
+         * hangs on MSB wraparound, so widen the field to 10 bits. */
+        if( param->b_psp_compat )
+            sps->i_log2_max_poc_lsb = 10;
     }
 
     sps->b_vui = 1;
