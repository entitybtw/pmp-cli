#!/usr/bin/env python3
"""
pmp-cli — PSP PMP converter / compressor

Commands:
  pmp-cli convert  <input.mp4>  [output.pmp]  [options]
  pmp-cli compress <input.pmp>  [output.pmp]  [options]
  pmp-cli batch    <dir|file...>              [options]

Requires: ffmpeg, ffprobe
"""

import argparse, struct, subprocess, os, sys, json, tempfile, shutil, glob

# --- PMP constants -----------------------------------------------------------
PMP_MAGIC   = 0x6d706d70
PMP_VERSION = 1
HDR_SIZE    = 56
DEF_W, DEF_H = 480, 272
FPS_MAX     = 29.97
PRESETS     = ['hyperfast','ultrafast','superfast','veryfast','faster',
               'fast','medium','slow','slower','veryslow']
PRESET_ALIAS = {'hyperfast': 'ultrafast'}

# --- helpers -----------------------------------------------------------------

def die(msg):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(1)

def resolve_preset(p):
    return PRESET_ALIAS.get(p, p)

def log(msg, verbose=True):
    if verbose:
        print(msg)

def is_keyframe(vdata: bytes) -> bool:
    """True if vdata contains NAL type 5 (IDR slice) - Annex B."""
    i = 0
    while i < len(vdata) - 4:
        if vdata[i:i+4] == b'\x00\x00\x00\x01':
            if i + 4 < len(vdata) and (vdata[i+4] & 0x1F) == 5:
                return True
            i += 4
        elif vdata[i:i+3] == b'\x00\x00\x01':
            if i + 3 < len(vdata) and (vdata[i+3] & 0x1F) == 5:
                return True
            i += 3
        else:
            i += 1
    return False

# --- PMP parse / build -------------------------------------------------------

def parse_pmp(data: bytes) -> dict:
    if len(data) < HDR_SIZE:
        die("file too small to be PMP")
    (magic, version,
     vid_format, n_vframes, width, height, vid_scale, vid_rate,
     aud_format, n_astreams, aud_max_frames, aud_scale, aud_rate, aud_stereo
    ) = struct.unpack_from('<14I', data, 0)

    if magic != PMP_MAGIC:
        die(f"not a PMP file (magic={hex(magic)})")
    if version != PMP_VERSION:
        die(f"unsupported PMP version: {version}")

    idx_off  = HDR_SIZE
    data_off = idx_off + n_vframes * 4
    index    = [struct.unpack_from('<I', data, idx_off + i*4)[0]
                for i in range(n_vframes)]

    packets = []
    pos = data_off
    for i in range(n_vframes):
        pkt_size = index[i] >> 1
        keyframe = index[i] & 1
        pkt = data[pos:pos+pkt_size]
        pos += pkt_size

        n_af = pkt[0]
        hn   = n_af * n_astreams + 3
        m    = struct.unpack_from(f'<{hn}I', pkt, 1)
        fd, ld, vlen = m[0], m[1], m[2]
        alens = list(m[3:])

        mhdr_sz = 1 + hn * 4
        vdata   = pkt[mhdr_sz:mhdr_sz+vlen]
        adata   = []
        apos    = mhdr_sz + vlen
        for al in alens:
            adata.append(pkt[apos:apos+al])
            apos += al

        packets.append({
            'kf': keyframe, 'n_af': n_af,
            'fd': fd, 'ld': ld,
            'vdata': vdata, 'adata': adata
        })

    return {
        'magic': magic, 'version': version,
        'vid_format': vid_format, 'n_vframes': n_vframes,
        'width': width, 'height': height,
        'vid_scale': vid_scale, 'vid_rate': vid_rate,
        'aud_format': aud_format, 'n_astreams': n_astreams,
        'aud_max_frames': aud_max_frames,
        'aud_scale': aud_scale, 'aud_rate': aud_rate, 'aud_stereo': aud_stereo,
        'fps': vid_rate / vid_scale,
        'packets': packets,
    }


def build_pmp(meta: dict, new_packets: list) -> bytes:
    n         = len(new_packets)
    n_astreams = meta['n_astreams']
    max_af    = max((p['n_af'] for p in new_packets), default=0)

    hdr = struct.pack('<14I',
        meta['magic'], meta['version'],
        meta['vid_format'], n,
        meta['width'], meta['height'],
        meta['vid_scale'], meta['vid_rate'],
        meta['aud_format'], n_astreams, max_af,
        meta['aud_scale'], meta['aud_rate'], meta['aud_stereo'],
    )

    raw_packets = []
    new_index   = []
    for p in new_packets:
        vdata, adata = p['vdata'], p['adata']
        n_af = p['n_af']
        hn   = n_af * n_astreams + 3
        
        # adata can be list[bytes] or list[dict] with 'data' key
        audio_data = []
        for a in adata:
            if isinstance(a, dict):
                audio_data.append(a['data'])
            else:
                audio_data.append(a)
        
        mini = struct.pack(f'<B{hn}I',
            n_af, p['fd'], p['ld'], len(vdata),
            *[len(a) for a in audio_data]
        )
        raw = mini + vdata + b''.join(audio_data)
        raw_packets.append(raw)
        new_index.append((len(raw) << 1) | p['kf'])

    idx_data = b''.join(struct.pack('<I', x) for x in new_index)
    pkt_data = b''.join(raw_packets)
    return hdr + idx_data + pkt_data

# --- video encoding ----------------------------------------------------------

def x264_params(args, br: int = None) -> str:
    # PMP AVC settings, exact match of XviD4PSP 5 "x264 HQ Extreme" preset.
    # xvid4psp CLI: --crf 21 --level 3.0 --ref 2 --deblock -2:-1
    #   --direct none --no-b-adapt --no-8x8dct --no-weightb --weightp 0
    #   --pictiming --bframes 0 --trellis 2 --no-fast-pskip --no-dct-decimate
    #   --aud --partitions p8x8,b8x8,i4x4,p4x4 --me umh --subme 9
    p = f"level={args.level}:ref=2:bframes=0:b-adapt=0:direct=none"
    p += ":deblock=-2,-1"
    p += ":me=umh:subme=9:trellis=2:partitions=p8x8,b8x8,i4x4,p4x4"
    p += ":cabac=1:8x8dct=0:weightp=0:weightb=0"
    p += ":no-fast-pskip=1:no-dct-decimate=1"
    p += ":aud=1:pic-struct=1:force-cfr=1"
    if args.extra_x264:
        p += ":" + args.extra_x264.strip(':')
    return p


def reorder_nals_for_psp(h264_data: bytes) -> bytes:
    """Reorder NAL units: move leading SEI after PPS for PSP compatibility.
    Target: AUD → SPS → PPS → SEI → IDR (PSP format)
    Input:  SEI → AUD → SPS → PPS → IDR (x264 default)
    """
    nals = []
    i = 0
    while i < len(h264_data) - 3:
        if h264_data[i:i+3] == b'\x00\x00\x01':
            start = i
            nal_type = h264_data[i+3] & 0x1f
            
            # Find end of NAL
            end = i + 4
            while end < len(h264_data) - 3:
                if h264_data[end:end+3] in (b'\x00\x00\x00', b'\x00\x00\x01'):
                    break
                end += 1
            
            nals.append((nal_type, start, end))
            
            # Stop after IDR
            if nal_type == 5:
                break
            i = end
        else:
            i += 1
    
    # Check if reordering is needed: SEI(6) before AUD(9)
    if len(nals) >= 4 and nals[0][0] == 6 and nals[1][0] == 9:
        sei_start, sei_end = nals[0][1], nals[0][2]
        
        # Find PPS position
        pps_end = None
        for nal_type, start, end in nals:
            if nal_type == 8:  # PPS
                pps_end = end
                break
        
        if pps_end:
            # Extract SEI NAL
            sei_nal = h264_data[sei_start:sei_end]
            # Build: [before SEI] + [AUD...PPS] + [SEI] + [rest]
            before_sei = h264_data[:sei_start]
            after_sei_to_pps = h264_data[sei_end:pps_end]
            after_pps = h264_data[pps_end:]
            
            return before_sei + after_sei_to_pps + sei_nal + after_pps
    
    return h264_data


class _BitWriter:
    def __init__(self):
        self.bits = []
    def write(self, v, n):
        for k in range(n - 1, -1, -1):
            self.bits.append((v >> k) & 1)
    def ue(self, v):
        code_num = v + 1
        l = code_num.bit_length()
        self.write(0, l - 1)
        self.write(code_num, l)
    def to_bytes(self):
        out = bytearray()
        for chunk in range(0, len(self.bits), 8):
            b = 0
            for bit in self.bits[chunk:chunk+8]:
                b = (b << 1) | bit
            b <<= (8 - len(self.bits[chunk:chunk+8]))
            out.append(b)
        return bytes(out)


class _BitReader:
    def __init__(self, data):
        self.bits = []
        for byte in data:
            self.bits.extend([(byte >> (7 - k)) & 1 for k in range(8)])
        self.i = 0
    def get(self, n):
        v = 0
        for _ in range(n):
            v = (v << 1) | self.bits[self.i]
            self.i += 1
        return v
    def ue(self):
        z = 0
        while self.bits[self.i] == 0:
            z += 1
            self.i += 1
        self.i += 1
        if z == 0:
            return 0
        return (1 << z) - 1 + self.get(z)


def parse_sps(sps: bytes):
    """Return dict of parsed SPS fields."""
    r = _BitReader(sps)
    out = {}
    out['profile_idc'] = r.get(8)
    out['constraint'] = r.get(8)
    out['level_idc'] = r.get(8)
    out['seq_parameter_set_id'] = r.ue()
    out['log2_max_frame_num_minus4'] = r.ue()
    out['pic_order_cnt_type'] = r.get(2)
    if out['pic_order_cnt_type'] == 0:
        out['log2_max_pic_order_cnt_lsb_minus4'] = r.ue()
    elif out['pic_order_cnt_type'] == 1:
        out['delta_pic_order_always_zero_flag'] = r.get(1)
        out['offset_for_non_ref_pic'] = r.ue()
        out['offset_for_top_to_bottom_field'] = r.ue()
        num = r.ue()
        out['num_ref_frames_in_pic_order_cnt_cycle'] = num
        out['offset_for_ref_frame'] = [r.ue() for _ in range(num)]
    out['max_num_ref_frames'] = r.ue()
    out['gaps_in_frame_num_value_allowed_flag'] = r.get(1)
    out['pic_width_in_mbs_minus1'] = r.ue()
    out['pic_height_in_map_units_minus1'] = r.ue()
    out['frame_mbs_only_flag'] = r.get(1)
    if not out['frame_mbs_only_flag']:
        out['mb_adaptive_frame_field_flag'] = r.get(1)
    out['direct_8x8_inference_flag'] = r.get(1)
    return out


def patch_sps_for_psp(h264_data: bytes) -> bytes:
    """Patch the first SPS NAL for PSP Media Engine compatibility.
    Rewrites log2_max_frame_num_minus4=4 and pic_order_cnt_type=1,
    matching xvid4psp reference SPS. Keeps dimensions and remaining fields.
    """
    i = 0
    while i < len(h264_data) - 3:
        if h264_data[i:i+3] == b'\x00\x00\x01' and (h264_data[i+3] & 0x1f) == 7:
            start = i
            end = i + 4
            while end < len(h264_data) - 3:
                if h264_data[end:end+3] in (b'\x00\x00\x01', b'\x00\x00\x00'):
                    break
                end += 1
            nal = h264_data[start:end]
            sps = nal[4:]
            try:
                f = parse_sps(sps)
                # Rewrite only up to and including direct_8x8_inference_flag,
                # then append ALL remaining bits verbatim.
                # To do that we locate the bit offset of the first remaining
                # field (which parse_sps consumed beyond it) by re-running a
                # targeted tokenizer that stops after direct_8x8_inference.
                r = _BitReader(sps)
                r.get(8); r.get(8); r.get(8)
                r.ue()          # seq_parameter_set_id
                r.ue()          # log2_max_frame_num_minus4 (patched value)
                poc_type = r.get(2)
                if poc_type == 0:
                    r.ue()
                elif poc_type == 1:
                    r.get(1)
                    r.ue(); r.ue()
                    for _ in range(r.ue()):
                        r.ue()
                r.ue()          # max_num_ref_frames
                r.get(1)        # gaps flag
                r.ue()          # width
                r.ue()          # height
                frame_only = r.get(1)
                if not frame_only:
                    r.get(1)
                r.get(1)        # direct_8x8_inference
                # r.i is now the bit offset where the untouched remainder starts
                remainder_bits = r.bits[r.i:]

                w = _BitWriter()
                w.write(f['profile_idc'], 8)
                w.write(f['constraint'], 8)
                w.write(f['level_idc'], 8)
                w.ue(f['seq_parameter_set_id'])
                w.ue(4)              # log2_max_frame_num_minus4 = 4
                w.write(1, 2)        # pic_order_cnt_type = 1
                w.write(0, 1)        # delta_pic_order_always_zero_flag
                w.ue(0)              # offset_for_non_ref_pic
                w.ue(0)              # offset_for_top_to_bottom_field
                w.ue(0)              # num_ref_frames_in_pic_order_cnt_cycle
                w.ue(f['max_num_ref_frames'])
                w.write(f['gaps_in_frame_num_value_allowed_flag'], 1)
                w.ue(f['pic_width_in_mbs_minus1'])
                w.ue(f['pic_height_in_map_units_minus1'])
                w.write(f['frame_mbs_only_flag'], 1)
                if not f['frame_mbs_only_flag']:
                    w.write(f['mb_adaptive_frame_field_flag'], 1)
                w.write(f['direct_8x8_inference_flag'], 1)
                w.bits.extend(remainder_bits)

                new_sps = w.to_bytes()
                esc = bytearray()
                zeros = 0
                for bte in new_sps:
                    if zeros >= 2 and bte <= 3:
                        esc.append(3)
                        zeros = 0
                    if bte == 0:
                        zeros += 1
                    else:
                        zeros = 0
                    esc.append(bte)

                new_nal = nal[:4] + bytes(esc)
                return h264_data[:start] + new_nal + h264_data[end:]
            except Exception:
                return h264_data
        i += 1
    return h264_data


def encode_video(src: str, width: int, height: int, fps,
                 args, tmp: str, verbose: bool,
                 video_mode: str = 'vbr',
                 video_bitrate: int = None) -> list:
    """Encode src -> H.264 Annex B, return list[bytes] (one per frame).
    video_mode='vbr' -> CRF (quality-based)
    video_mode='cbr' -> constant bitrate, requires video_bitrate (kbps)

    Encoding backend:
      - built-in native x264 (bin/x264, built with --psp-compat) when present —
        produces the PSP reference SPS (log2_max_frame_num_minus4=5,
        pic_order_cnt_type=0) directly, no wine needed;
      - --x264-exe overrides the binary: a native (non-.exe) build is run
        directly with --psp-compat; a .exe is run via wine (legacy);
      - otherwise falls back to ffmpeg libx264 with the same xvid4psp preset.
    """
    ll   = 'warning' if verbose else 'error'
    mp4  = os.path.join(tmp, 'v.mp4')
    h264 = os.path.join(tmp, 'v.h264')

    vf = (f"scale={width}:{height}:force_original_aspect_ratio=decrease,"
          f"pad={width}:{height}:(ow-iw)/2:(oh-ih)/2")
    if getattr(args, 'deinterlace', False):
        vf = f"yadif," + vf

    x264_exe = getattr(args, 'x264_exe', None)
    if not x264_exe:
        bundled = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'bin', 'x264')
        if os.path.isfile(bundled) and os.access(bundled, os.X_OK):
            x264_exe = bundled

    use_native = bool(x264_exe) and not str(x264_exe).lower().endswith('.exe')

    if x264_exe:
        # --- real x264, exact XviD4PSP 5 "x264 HQ Extreme" preset --------
        # Native build runs directly with --psp-compat (reference SPS);
        # a Windows .exe is run via wine (legacy).
        y4m  = os.path.join(tmp, 'v.y4m')
        cmd = [
            'ffmpeg', '-y', '-hide_banner', '-loglevel', ll,
            '-i', src, '-map', '0:v:0', '-vf', vf,
        ]
        if fps:
            cmd += ['-r', str(fps)]
        cmd += ['-f', 'yuv4mpegpipe', y4m]
        subprocess.run(cmd, check=True)

        x264_cli = [
            '--profile', 'baseline', '--level', '3.0', '--ref', '2', '--deblock', '-2:-1',
            '--direct', 'none', '--no-b-adapt',
            '--no-8x8dct', '--no-weightb', '--weightp', '0',
            '--bframes', '0', '--trellis', '2',
            '--no-fast-pskip', '--no-dct-decimate', '--aud',
            '--partitions', 'p8x8,b8x8,i4x4,p4x4',
            '--me', 'umh', '--subme', '9',
        ]
        if use_native:
            x264_cli += ['--psp-compat']
        else:
            # legacy .exe (2009 build) has --pictiming but no --psp-compat
            x264_cli += ['--pictiming']

        if video_mode == 'cbr':
            if not video_bitrate:
                die("--video-bitrate is required for --video-mode cbr")
            x264_cli += ['--bitrate', str(video_bitrate)]
        else:
            x264_cli += ['--crf', str(args.crf)]

        runner = [str(x264_exe)] if use_native else ['wine', str(x264_exe)]
        subprocess.run(
            [*runner, *x264_cli, '-o', h264, y4m],
            check=True)
    else:
        # --- ffmpeg libx264 with the same xvid4psp preset ---------------
        if video_mode == 'cbr':
            if not video_bitrate:
                die("--video-bitrate is required for --video-mode cbr")
            br = video_bitrate
            rate_args = [
                '-b:v', f'{br}k',
                '-minrate', f'{br}k',
                '-maxrate', f'{br}k',
                '-bufsize', f'{br*2}k',
            ]
        else:
            br = None
            rate_args = ['-crf', str(args.crf)]

        cmd = [
            'ffmpeg', '-y', '-hide_banner', '-loglevel', ll,
            '-i', src,
            '-map', '0:v:0',
            '-c:v', 'libx264', '-preset', args.preset,
            '-g', str(args.keyint),
            '-vf', vf,
            *rate_args,
            '-x264-params', x264_params(args, br), '-an',
        ]
        if fps:
            cmd += ['-r', str(fps)]
        cmd.append(mp4)
        subprocess.run(cmd, check=True)

        # Convert to Annex B and reorder NALs: move initial SEI after PPS
        subprocess.run([
            'ffmpeg', '-y', '-hide_banner', '-loglevel', 'error',
            '-i', mp4, '-c:v', 'copy',
            '-bsf:v', 'h264_mp4toannexb', '-f', 'h264', h264
        ], check=True)

    res = subprocess.run([
        'ffprobe', '-v', 'quiet',
        '-select_streams', 'v:0',
        '-show_packets', '-print_format', 'json', h264
    ], capture_output=True, text=True, check=True)

    pkts = json.loads(res.stdout)['packets']
    with open(h264, 'rb') as f:
        raw = f.read()
    
    # Reorder NAL units for PSP compatibility
    raw = reorder_nals_for_psp(raw)

    frames = []
    for p in pkts:
        pos  = int(p['pos'])
        size = int(p['size'])
        frames.append(raw[pos:pos+size])
    return frames

# --- audio extraction / re-encode --------------------------------------------

def _aac_rate_args(audio_mode: str, audio_bitrate: int, audio_quality: float) -> list:
    if audio_mode == 'vbr':
        return ['-q:a', str(audio_quality)]
    else:
        return ['-b:a', f'{audio_bitrate}k']


def _audio_channels(args) -> tuple:
    """Return (ac, aud_stereo) from --audio-channels."""
    if args.audio_channels == 'mono':
        return 1, 0
    return 2, 1


def extract_audio(src: str, tmp: str, aud_rate: int, ac: int,
                  audio_mode: str, audio_bitrate: int,
                  audio_quality: float, verbose: bool) -> list:
    """Extract/re-encode audio from any source -> ADTS AAC.
    Returns list of dicts {data, pts_us}."""
    ll  = 'warning' if verbose else 'error'
    aac = os.path.join(tmp, 'a.aac')

    subprocess.run([
        'ffmpeg', '-y', '-hide_banner', '-loglevel', ll,
        '-i', src, '-vn',
        '-c:a', 'aac', '-ar', str(aud_rate), '-ac', str(ac),
        *_aac_rate_args(audio_mode, audio_bitrate, audio_quality),
        aac
    ], check=True)

    return _aac_frames(aac)


def extract_raw_audio_from_pmp(pmp_data: bytes, meta: dict) -> list:
    """Extract raw audio frames directly from PMP without re-encoding.
    Returns list of {data, pts_us} - preserves original audio data."""
    packets = parse_pmp(pmp_data)['packets']
    
    frames = []
    frame_idx = 0
    aac_dur_us = int(1024 * 1_000_000 / meta['aud_rate'])
    
    for pkt in packets:
        for adata in pkt['adata']:
            if len(adata) > 0:
                pts_us = frame_idx * aac_dur_us
                frames.append({'data': adata, 'pts_us': pts_us})
                frame_idx += 1
    
    return frames


def recompress_audio_from_pmp(pmp_path: str, tmp: str, aud_rate: int, ac: int,
                              audio_mode: str, audio_bitrate: int,
                              audio_quality: float, verbose: bool) -> list:
    """Re-encode audio from PMP file -> ADTS AAC.
    Uses ffmpeg's built-in PMP demuxer to extract audio correctly.
    Returns list of {data, pts_us}."""
    ll = 'warning' if verbose else 'error'
    reenc = os.path.join(tmp, 'reenc_a.aac')

    try:
        subprocess.run([
            'ffmpeg', '-y', '-hide_banner', '-loglevel', ll,
            '-i', pmp_path,
            '-map', '0:a:0', '-vn',
            '-c:a', 'aac', '-ar', str(aud_rate), '-ac', str(ac),
            *_aac_rate_args(audio_mode, audio_bitrate, audio_quality),
            reenc
        ], check=True, capture_output=True)

        return _aac_frames(reenc)
    except subprocess.CalledProcessError as e:
        log(f"  warning: audio re-encode failed: {e}", verbose)
        log(f"  keeping original audio unchanged", verbose)
        return []


def _aac_frames(aac_path: str) -> list:
    """Parse ADTS AAC file -> list of {data, pts_us}.
    Strips ADTS headers (7 bytes) to produce raw AAC frames for PSP.
    """
    res = subprocess.run([
        'ffprobe', '-v', 'quiet',
        '-select_streams', 'a:0',
        '-show_packets', '-print_format', 'json', aac_path
    ], capture_output=True, text=True, check=True)

    pkts = json.loads(res.stdout).get('packets', [])
    with open(aac_path, 'rb') as f:
        raw = f.read()

    frames = []
    for p in pkts:
        if p.get('pos', '-1') in ('-1', 'N/A'):
            continue
        pos   = int(p['pos'])
        size  = int(p['size'])
        pts_s = float(p.get('pts_time') or p.get('dts_time') or '0')
        # Strip ADTS header (7 bytes) - PSP expects raw AAC
        adts_hdr_size = 7
        if size > adts_hdr_size:
            frame_data = raw[pos+adts_hdr_size:pos+size]
        else:
            frame_data = raw[pos:pos+size]  # fallback if frame is too small
        frames.append({'data': frame_data, 'pts_us': int(pts_s * 1e6)})
    return frames


def align_audio(n_vframes: int, fps: float, aframes: list) -> list:
    """Group audio frames into buckets per video frame.
    Returns list of buckets, each containing {'data': bytes, 'pts_us': int}."""
    dur = 1_000_000.0 / fps
    buckets = [[] for _ in range(n_vframes)]
    for af in aframes:
        idx = int(af['pts_us'] / dur)
        idx = min(idx, n_vframes - 1)
        buckets[idx].append({'data': af['data'], 'pts_us': af['pts_us']})
    return buckets


def delays_for(frame_idx: int, fps: float, bucket: list, aud_rate: int) -> tuple:
    """Compute (first_delay, last_delay) in microseconds.
    fd = when first audio frame starts relative to this video frame
    ld = when last audio frame ends relative to next video frame"""
    if not bucket:
        frame_dur = int(1_000_000 / fps)
        return 0, frame_dur
    
    aac_dur = int(1024 * 1_000_000 / aud_rate)
    video_start = int(frame_idx * 1_000_000 / fps)
    next_video_start = int((frame_idx + 1) * 1_000_000 / fps)
    
    first_audio_start = bucket[0]['pts_us']
    last_audio_end = bucket[-1]['pts_us'] + aac_dur
    
    fd = first_audio_start - video_start
    ld = last_audio_end - next_video_start
    
    # Clamp to uint32 range to avoid struct.pack overflow
    fd = max(0, min(fd, 4294967295))
    ld = max(0, min(ld, 4294967295))
    
    return fd, ld

# --- subcommands -------------------------------------------------------------

def _stream_flags(args) -> tuple:
    """Return (do_video, do_audio) based on --stream flag."""
    s = getattr(args, 'stream', 'both')
    return (s in ('video', 'both')), (s in ('audio', 'both'))


def do_compress(src: str, dst: str, args, verbose: bool):
    """PMP -> PMP: re-encode video and/or audio.

    Uses the chain: decode PMP -> MP4 (lossless-ish, preserves WxH/fps),
    optionally squeeze the MP4, then convert back to PMP with the same
    resolution/fps so the container structure is preserved exactly.
    """
    args.preset = resolve_preset(args.preset)
    log(f"compress: {src} -> {dst}", verbose)

    meta = parse_pmp(open(src, 'rb').read())
    fps  = meta['fps']
    w, h = meta['width'], meta['height']
    do_vid, do_aud = _stream_flags(args)

    mode_v = getattr(args, 'video_mode', 'vbr')
    mode_a = getattr(args, 'audio_mode', 'cbr')
    vbr_v  = getattr(args, 'video_bitrate', None)
    aq     = getattr(args, 'audio_quality', 2.0)
    ac, aud_stereo = _audio_channels(args)

    stream = 'video' if do_vid and not do_aud else 'audio' if do_aud and not do_vid else 'both'
    log(f"  {w}x{h} @ {fps:.2f}fps  {meta['n_vframes']} frames  [stream={stream}]", verbose)

    src_mb = os.path.getsize(src) / 1048576
    tmp = tempfile.mkdtemp(prefix='pmpcli_')
    try:
        # Step 1: decode PMP -> MP4 (h264 + aac, preserves WxH/fps).
        mp4 = os.path.join(tmp, 'step.mp4')
        decode_cmd = [
            'ffmpeg', '-y', '-hide_banner', '-loglevel', 'error',
            '-i', src, '-c:v', 'libx264',
            '-preset', 'faster', '-crf', '16', '-pix_fmt', 'yuv420p',
            '-c:a', 'aac', '-b:a', '192k',
            '-movflags', '+faststart', mp4,
        ]
        subprocess.run(decode_cmd, check=True)

        # Step 2: convert the decoded MP4 back to PMP. Resolution/fps are
        # taken from the source (do_convert auto-picks them when width/height
        # are None), so the structure is preserved.

        # Save user override of the auto size so do_convert picks source dims.
        saved_w, saved_h = args.width, args.height
        args.width, args.height = None, None

        try:
            do_convert(mp4, dst, args, verbose)
        finally:
            args.width, args.height = saved_w, saved_h

        dst_mb = os.path.getsize(dst) / 1048576
        log(f"  {src_mb:.2f} MB -> {dst_mb:.2f} MB  "
            f"({100*(1-dst_mb/src_mb):.1f}% smaller)", verbose)
    finally:
        if not args.keep_temp:
            shutil.rmtree(tmp, ignore_errors=True)
        else:
            log(f"  temp: {tmp}", verbose)


def do_convert(src: str, dst: str, args, verbose: bool):
    """MP4 (or any video) -> PMP."""
    log(f"convert: {src} -> {dst}", verbose)
    args.preset = resolve_preset(args.preset)

    mode_v = getattr(args, 'video_mode', 'vbr')
    mode_a = getattr(args, 'audio_mode', 'cbr')
    vbr_v  = getattr(args, 'video_bitrate', None)
    aq     = getattr(args, 'audio_quality', 2.0)
    ac, aud_stereo = _audio_channels(args)

    res = subprocess.run([
        'ffprobe', '-v', 'quiet',
        '-print_format', 'json', '-show_streams', src
    ], capture_output=True, text=True, check=True)
    streams = json.loads(res.stdout)['streams']

    has_audio = any(s['codec_type'] == 'audio' for s in streams)
    vstream   = next((s for s in streams if s['codec_type'] == 'video'), None)
    if not vstream:
        die(f"no video stream in {src}")

    # FPS: PMP spec allows 1..~38, but >29.97fps is not recommended.
    # --fps is capped at FPS_MAX; default is source fps (or FPS_MAX if higher).
    if args.fps:
        if args.fps <= 0:
            die("--fps must be > 0")
        fps = min(args.fps, FPS_MAX)
    else:
        fr = vstream.get('r_frame_rate', '30/1')
        try:
            a, b = fr.split('/')
            src_fps = float(a) / float(b)
        except (ValueError, ZeroDivisionError):
            src_fps = 0
        fps = min(FPS_MAX, src_fps) if src_fps else FPS_MAX

    width  = args.width
    height = args.height

    # If width/height were not requested, preserve the source's dimensions.
    if width is None or height is None:
        width  = int(vstream.get('width',  DEF_W)) or DEF_W
        height = int(vstream.get('height', DEF_H)) or DEF_H
        # Force to a multiple of 16 for PSP compatibility.
        width  -= width  % 16
        height -= height % 16

    vid_scale = 1000
    vid_rate  = round(fps * 1000)

    aud_rate   = args.audio_rate
    aud_format = 1
    n_astreams = 1 if has_audio and not args.no_audio else 0
    aud_scale  = 1024   # AAC frame size in samples
    if n_astreams == 0:
        aud_stereo = 0

    tmp = tempfile.mkdtemp(prefix='pmpcli_')
    try:
        new_vframes = encode_video(
            src, width, height, fps,
            args, tmp, verbose,
            video_mode=mode_v, video_bitrate=vbr_v
        )
        n_vframes = len(new_vframes)
        log(f"  video: {n_vframes} frames @ {fps:.3f}fps  "
            f"{width}x{height}  [{mode_v}]", verbose)

        audio_buckets = [[] for _ in range(n_vframes)]
        if n_astreams > 0:
            aframes = extract_audio(src, tmp, aud_rate, ac,
                                    mode_a, args.audio_bitrate, aq, verbose)
            audio_buckets = align_audio(n_vframes, fps, aframes)
            log(f"  audio: {len(aframes)} AAC frames distributed  [{mode_a}]", verbose)

        new_pkts = []
        for i in range(n_vframes):
            vd     = new_vframes[i]
            bucket = audio_buckets[i]
            kf     = 1 if is_keyframe(vd) else 0
            n_af   = len(bucket)
            fd, ld = delays_for(i, fps, bucket, aud_rate)
            new_pkts.append({
                'kf': kf, 'n_af': n_af,
                'fd': fd, 'ld': ld,
                'vdata': vd, 'adata': bucket
            })

        max_af = max((p['n_af'] for p in new_pkts), default=0)
        meta = {
            'magic': PMP_MAGIC, 'version': PMP_VERSION,
            'vid_format': 1,
            'n_vframes': n_vframes,
            'width': width, 'height': height,
            'vid_scale': vid_scale, 'vid_rate': vid_rate,
            'aud_format': aud_format, 'n_astreams': n_astreams,
            'aud_max_frames': max_af,
            'aud_scale': aud_scale, 'aud_rate': aud_rate,
            'aud_stereo': aud_stereo,
            'fps': fps,
        }

        out = build_pmp(meta, new_pkts)
        os.makedirs(os.path.dirname(os.path.abspath(dst)), exist_ok=True)
        with open(dst, 'wb') as f:
            f.write(out)
        log(f"  {len(out)/1048576:.2f} MB -> {dst}", verbose)
    finally:
        if not args.keep_temp:
            shutil.rmtree(tmp, ignore_errors=True)
        else:
            log(f"  temp: {tmp}", verbose)


def do_decode(src: str, dst: str, args, verbose: bool):
    """PMP -> MP4: decode to a playable MP4 (re-encode h264 + aac).

    ffmpeg's pmp demuxer can't stream-copy (video packets come out empty
    and AAC isn't fully parsed), so both streams are re-encoded.
    """
    log(f"decode: {src} -> {dst}", verbose)
    ll = 'warning' if verbose else 'error'

    res = subprocess.run([
        'ffprobe', '-v', 'error',
        '-print_format', 'json', '-show_streams', src
    ], capture_output=True, text=True)
    if res.returncode != 0:
        die(f"ffprobe failed on {src}")
    streams = json.loads(res.stdout).get('streams', [])

    has_video = any(s['codec_type'] == 'video' for s in streams)
    has_audio = any(s['codec_type'] == 'audio' for s in streams)
    do_video  = has_video and not args.no_video
    do_audio  = has_audio and not args.no_audio

    if not do_video and not do_audio:
        die("nothing to decode (no matching streams / --no-video --no-audio)")
    if not has_video:
        log("  no video stream in source", verbose)
    if not has_audio:
        log("  no audio stream in source", verbose)

    cmd = ['ffmpeg', '-y', '-hide_banner', '-loglevel', ll, '-i', src]
    if do_video:
        cmd += ['-map', '0:v:0', '-c:v', 'libx264',
                '-preset', args.preset, '-crf', str(args.crf),
                '-pix_fmt', 'yuv420p']
    else:
        cmd += ['-vn']
    if do_audio:
        cmd += ['-map', '0:a:0', '-c:a', 'aac',
                '-b:a', f'{args.audio_bitrate}k']
    else:
        cmd += ['-an']
    cmd += ['-movflags', '+faststart', dst]

    subprocess.run(cmd, check=True)

    src_mb = os.path.getsize(src)  / 1048576
    dst_mb = os.path.getsize(dst)  / 1048576
    log(f"  {src_mb:.2f} MB PMP -> {dst_mb:.2f} MB MP4", verbose)

# --- batch -------------------------------------------------------------------

def collect_files(paths: list, recursive: bool, mode: str) -> list:
    """Collect input files from paths (files or dirs)."""
    exts = {
        'compress': {'.pmp'},
        'convert':  {'.mp4', '.mkv', '.avi', '.mov', '.flv', '.webm'},
        'both':     {'.pmp', '.mp4', '.mkv', '.avi', '.mov', '.flv', '.webm'},
    }[mode]

    result = []
    for p in paths:
        if os.path.isfile(p):
            if os.path.splitext(p)[1].lower() in exts:
                result.append(os.path.abspath(p))
        elif os.path.isdir(p):
            pattern = '**/*' if recursive else '*'
            for ext in exts:
                for fp in glob.glob(os.path.join(p, pattern + ext),
                                    recursive=recursive):
                    result.append(os.path.abspath(fp))
        else:
            print(f"skip: not found: {p}", file=sys.stderr)
    return sorted(set(result))


def batch_output(src: str, batch_mode: str, args) -> str:
    """Determine output path for a batch item."""
    base, ext = os.path.splitext(src)
    if batch_mode == 'compress':
        out_name = base + args.suffix + '.pmp'
    else:
        out_name = base + '.pmp'

    if args.output_dir:
        out_name = os.path.join(args.output_dir,
                                os.path.basename(out_name))
    return out_name


def cmd_convert(args):
    src = os.path.expanduser(args.input)
    dst = os.path.expanduser(args.output) if args.output else None
    dst = dst or (os.path.splitext(src)[0] + '.pmp')
    do_convert(src, dst, args, verbose=not args.quiet)


def cmd_compress(args):
    src = os.path.expanduser(args.input)
    dst = os.path.expanduser(args.output) if args.output else None
    dst = dst or (os.path.splitext(src)[0] + args.suffix + '.pmp')
    do_compress(src, dst, args, verbose=not args.quiet)


def cmd_decode(args):
    src = os.path.expanduser(args.input)
    dst = os.path.expanduser(args.output) if args.output else None
    dst = dst or (os.path.splitext(src)[0] + '.mp4')
    do_decode(src, dst, args, verbose=not args.quiet)


def cmd_batch(args):
    batch_mode = args.batch_mode   # compress | convert
    args.paths = [os.path.expanduser(p) for p in args.paths]
    files = collect_files(args.paths, args.recursive, batch_mode)

    if not files:
        die("no matching files")

    print(f"batch: {len(files)} files ({batch_mode})")
    if args.dry_run:
        for f in files:
            print(f"  {f} -> {batch_output(f, batch_mode, args)}")
        return

    ok = fail = 0
    for i, src in enumerate(files, 1):
        dst = batch_output(src, batch_mode, args)
        print(f"[{i}/{len(files)}] {os.path.basename(src)}")

        if args.replace:
            tmp_dst = dst + '.pmctmp'
            real_dst = src if batch_mode == 'compress' else dst
            try:
                if batch_mode == 'compress':
                    do_compress(src, tmp_dst, args, verbose=not args.quiet)
                else:
                    do_convert(src, tmp_dst, args, verbose=not args.quiet)
                shutil.move(tmp_dst, real_dst)
                ok += 1
            except Exception as e:
                print(f"  error: {e}", file=sys.stderr)
                if os.path.exists(tmp_dst):
                    os.remove(tmp_dst)
                fail += 1
        else:
            try:
                if batch_mode == 'compress':
                    do_compress(src, dst, args, verbose=not args.quiet)
                else:
                    do_convert(src, dst, args, verbose=not args.quiet)
                ok += 1
            except Exception as e:
                print(f"  error: {e}", file=sys.stderr)
                fail += 1

    print(f"done: {ok} ok, {fail} failed")

# --- argument parser ---------------------------------------------------------

def add_encode_args(p):
    g_vid = p.add_argument_group('video')
    g_vid.add_argument('--video-mode', dest='video_mode',
                       choices=['vbr', 'cbr'], default='vbr',
                       help='video bitrate mode: vbr=CRF, cbr=constant (default: vbr)')
    g_vid.add_argument('--crf',        type=int, default=21,
                       help='CRF quality [vbr] 0-51, lower=better (default: 21)')
    g_vid.add_argument('--video-bitrate', type=int, default=None,
                       dest='video_bitrate',
                       help='video bitrate in kbps [cbr], e.g. 1500')
    g_vid.add_argument('--preset',     default='slow',
                       choices=PRESETS,
                       help='x264 preset (default: slow)')
    g_vid.add_argument('--profile',    default='baseline',
                       choices=['baseline', 'main', 'high'],
                       help='H.264 profile (default: baseline for PSP compatibility)')
    g_vid.add_argument('--level',      default='3.0',
                       help='H.264 level, e.g. 1.3/2.1/3.0 (default: 1.3 for PSP)')
    g_vid.add_argument('--bframes',    type=int, default=0, choices=[0, 1, 2],
                       help='max B-frames (default: 0)')
    g_vid.add_argument('--deinterlace', action='store_true',
                       help='deinterlace source with yadif')
    g_vid.add_argument('--width',      type=int, default=DEF_W,
                       help=f'width (default: {DEF_W})')
    g_vid.add_argument('--height',     type=int, default=DEF_H,
                       help=f'height (default: {DEF_H})')
    g_vid.add_argument('--fps',        type=float, default=None,
                       help=f'output fps (max {FPS_MAX}, >25 not recommended; default: 24 or source)')
    g_vid.add_argument('--vbv-maxrate', type=int, default=768,
                       dest='vbv_maxrate',
                       help='VBV maxrate kbps [vbr] (default: 768 for Level 1.3)')
    g_vid.add_argument('--vbv-bufsize', type=int, default=2000,
                       dest='vbv_bufsize',
                       help='VBV bufsize kbps [vbr] (default: 2000 for Level 1.3)')
    g_vid.add_argument('--keyint',     type=int, default=250,
                       help='keyframe interval (default: 250)')
    g_vid.add_argument('--extra-x264', default='', dest='extra_x264',
                       help='extra x264 params, e.g. "me=hex:subme=7"')
    g_vid.add_argument('--x264-exe', default=None, dest='x264_exe',
                       help='path to a x264 binary for PSP reference SPS. '
                            'Native (non-.exe) builds are run directly with '
                            '--psp-compat; a .exe runs via wine (legacy). '
                            'Default: bundled bin/x264 when present.')

    g_aud = p.add_argument_group('audio')
    g_aud.add_argument('--audio-mode', dest='audio_mode',
                       choices=['vbr', 'cbr'], default='cbr',
                       help='audio bitrate mode: vbr=quality, cbr=constant (default: cbr)')
    g_aud.add_argument('--audio-bitrate', type=int, default=96,
                       dest='audio_bitrate',
                       help='audio bitrate kbps [cbr] (default: 96)')
    g_aud.add_argument('--audio-quality', type=float, default=2.0,
                       dest='audio_quality',
                       help='AAC VBR quality [vbr]: 0.1(best)...5.0(worst) (default: 2.0)')
    g_aud.add_argument('--audio-rate', type=int, default=44100,
                       dest='audio_rate', choices=[32000, 44100, 48000],
                       help='audio sample rate (default: 44100)')
    g_aud.add_argument('--audio-channels', default='stereo',
                       dest='audio_channels', choices=['mono', 'stereo'],
                       help='audio channels (default: stereo)')
    g_aud.add_argument('--no-audio',   action='store_true', dest='no_audio',
                       help='strip audio from output')

    p.add_argument('--stream',
                   choices=['video', 'audio', 'both'], default='both',
                   help='what to compress: video/audio/both (default: both)')

    p.add_argument('--suffix',     default='_compressed',
                   help='output filename suffix (default: _compressed)')
    p.add_argument('--keep-temp',  action='store_true', dest='keep_temp',
                   help='keep temporary folder')
    p.add_argument('-q', '--quiet', action='store_true',
                   help='quiet mode')


def build_parser():
    parser = argparse.ArgumentParser(
        prog='pmp-cli',
        description='PSP PMP converter / compressor',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  # VBR video (CRF) + CBR audio (defaults)
  pmp-cli convert video.mp4 out.pmp --crf 26 --audio-bitrate 96

  # CBR video + VBR audio
  pmp-cli convert video.mp4 out.pmp --video-mode cbr --video-bitrate 1500 \\
              --audio-mode vbr --audio-quality 1.5

  # force fps (max 25)
  pmp-cli convert video.mp4 out.pmp --fps 25

  # compress video only (keep audio)
  pmp-cli compress movie.pmp --stream video --crf 30 --preset fast

  # compress audio only (keep video)
  pmp-cli compress movie.pmp --stream audio --audio-mode vbr --audio-quality 3.0

  # batch: replace all .pmp recursively, video only
  pmp-cli batch ./pmps/ --batch-mode compress --recursive --replace --stream video

  # batch: convert all MP4 in folder
  pmp-cli batch ./videos/ --batch-mode convert --output-dir ./out/
"""
    )

    sub = parser.add_subparsers(dest='cmd')

    p_conv = sub.add_parser('convert', help='MP4/MKV/... -> PMP')
    p_conv.add_argument('input',  help='input video file')
    p_conv.add_argument('output', nargs='?', help='output .pmp (default: next to input)')
    add_encode_args(p_conv)

    p_comp = sub.add_parser('compress', help='PMP -> PMP (re-encode, smaller)')
    p_comp.add_argument('input',  help='input .pmp')
    p_comp.add_argument('output', nargs='?', help='output .pmp (default: <name>_compressed.pmp)')
    add_encode_args(p_comp)

    p_dec = sub.add_parser('decode', help='PMP -> MP4 (decode to playable file)')
    p_dec.add_argument('input',  help='input .pmp')
    p_dec.add_argument('output', nargs='?', help='output .mp4 (default: next to input)')
    g_vid = p_dec.add_argument_group('video')
    g_vid.add_argument('--crf',     type=int, default=21,
                       help='H.264 CRF quality 0-51, lower=better (default: 21)')
    g_vid.add_argument('--preset',  default='slow', choices=PRESETS,
                       help='H.264 x264 preset (default: slow)')
    g_vid.add_argument('--no-video', action='store_true', dest='no_video',
                       help='strip video from output')
    g_aud = p_dec.add_argument_group('audio')
    g_aud.add_argument('--audio-bitrate', type=int, default=192,
                       dest='audio_bitrate',
                       help='AAC bitrate kbps (default: 192)')
    g_aud.add_argument('--no-audio', action='store_true', dest='no_audio',
                       help='strip audio from output')
    p_dec.add_argument('-q', '--quiet', action='store_true',
                       help='quiet mode')
    p_dec.add_argument('--keep-temp', action='store_true', dest='keep_temp',
                       help='keep temporary folder (unused)')

    p_bat = sub.add_parser('batch', help='batch process files / directories')
    p_bat.add_argument('paths', nargs='+',
                       help='files and/or directories to process')
    p_bat.add_argument('--batch-mode', dest='batch_mode',
                       choices=['compress', 'convert'], default='compress',
                       help='compress (PMP->PMP) or convert (MP4->PMP) (default: compress)')
    p_bat.add_argument('-r', '--recursive', action='store_true',
                       help='recurse into subdirectories')
    p_bat.add_argument('--replace', action='store_true',
                       help='replace originals (atomic via temp)')
    p_bat.add_argument('--output-dir', dest='output_dir', default=None,
                       help='output folder (default: next to source)')
    p_bat.add_argument('--dry-run', action='store_true', dest='dry_run',
                       help='show what would be done, do nothing')
    add_encode_args(p_bat)

    return parser


def main():
    parser = build_parser()
    args   = parser.parse_args()

    if not args.cmd:
        parser.print_help()
        sys.exit(0)

    for dep in ('ffmpeg', 'ffprobe'):
        if shutil.which(dep) is None:
            die(f"{dep} not found in PATH")

    if args.cmd == 'convert':
        cmd_convert(args)
    elif args.cmd == 'compress':
        cmd_compress(args)
    elif args.cmd == 'decode':
        cmd_decode(args)
    elif args.cmd == 'batch':
        cmd_batch(args)


if __name__ == '__main__':
    main()
