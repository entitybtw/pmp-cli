#!/usr/bin/env python3
"""
pmp-cli — PSP PMP converter / compressor

Commands:
  pmp-cli convert  <input.mp4>  [output.pmp]  [options]
  pmp-cli compress <input.pmp>  [output.pmp]  [options]
  pmp-cli batch    <dir|file...>              [options]

Requires: ffmpeg, ffprobe
"""

import argparse, struct, subprocess, os, sys, json, tempfile, shutil, glob

# --- PMP constants -----------------------------------------------------------
PMP_MAGIC   = 0x6d706d70
PMP_VERSION = 1
HDR_SIZE    = 56
DEF_W, DEF_H = 480, 272
FPS_MAX     = 29.97
PRESETS     = ['hyperfast','ultrafast','superfast','veryfast','faster',
               'fast','medium','slow','slower','veryslow']
PRESET_ALIAS = {'hyperfast': 'ultrafast'}

# --- helpers -----------------------------------------------------------------

def die(msg):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(1)

def resolve_preset(p):
    return PRESET_ALIAS.get(p, p)

def log(msg, verbose=True):
    if verbose:
        print(msg)

def is_keyframe(vdata: bytes) -> bool:
    """True if vdata contains NAL type 5 (IDR slice) - Annex B."""
    i = 0
    while i < len(vdata) - 4:
        if vdata[i:i+4] == b'\x00\x00\x00\x01':
            if i + 4 < len(vdata) and (vdata[i+4] & 0x1F) == 5:
                return True
            i += 4
        elif vdata[i:i+3] == b'\x00\x00\x01':
            if i + 3 < len(vdata) and (vdata[i+3] & 0x1F) == 5:
                return True
            i += 3
        else:
            i += 1
    return False


# --- PMP container rules (from pmp_muxer_avc / pmp_mod_avc sources) ---------
#
# Reference muxer  : http://jonny.leffe.dnsalias.com/pmp_mod_avc/ (pmp_muxer_avc)
# Reference player : pmp_mod_avc (video -> sceMpegAvcDecode, audio -> libav)
#
#  * video.format      == 1 (H.264), audio.format 0 = MP3, 1 = AAC
#  * width/height      multiple of 16, <= 480 x 272
#  * aud_scale         samples per audio frame (1152 = MP3, 1024 = AAC)
#  * every access unit starts with a 4-byte AUD, IDRs carry SPS/PPS in band
#  * index keyframe bit: AUD(primary_pic_type == 0) followed by an SPS
#  * first_delay/last_delay are measured in microseconds and satisfy
#        first_delay + audio_span + last_delay == video_frame_duration
#    (see time_math.pm of the official muxer)

MAX_AU_SIZE = 0x40000   # sanity cap for one video access unit.  The reference
                        # player DMAs the AU to the fixed ME buffer at 0x4a000
                        # (avc.c: MEAVCBUF) - an oversized AU would be written
                        # past that region on real hardware.


def nal_units(vdata: bytes) -> list:
    """Split an Annex B access unit into (nal_type, start, end, startcode_len)."""
    starts = []
    i, n = 0, len(vdata)
    while i + 3 < n:
        if vdata[i] != 0:            # cheap guard, most bytes are not 0
            i += 1
            continue
        if vdata[i:i+4] == b'\x00\x00\x00\x01':
            starts.append((i, 4)); i += 4
        elif vdata[i+1] == 0 and vdata[i+2] == 1:
            starts.append((i, 3)); i += 3
        else:
            i += 1
    out = []
    for k, (s, sc) in enumerate(starts):
        if s + sc >= n:
            break
        e = starts[k+1][0] if k + 1 < len(starts) else n
        out.append((vdata[s+sc] & 0x1f, s, e, sc))
    return out


def keyframe_flag(vdata: bytes) -> bool:
    """Index keyframe bit using the reference pmp_muxer_avc rule.

    The official avc_parser only cuts frames on 00 00 00 01 09 (AUD) and marks
    a frame as keyframe when the AUD says "I only" (primary_pic_type == 0) and
    the next NAL is an SPS - i.e. the decoder can restart from this packet.
    Falls back to a plain IDR (NAL type 5) search for AUD-less streams.
    """
    nals = nal_units(vdata)
    if not nals:
        return False
    ntype, start, _, sc = nals[0]
    if ntype == 9 and sc == 4:
        payload = start + sc + 1
        if payload >= len(vdata) or (vdata[payload] >> 5) != 0:
            return False
        return len(nals) > 1 and nals[1][0] == 7 and nals[1][3] == 4
    return is_keyframe(vdata)


def _time_of(frame_number: int, scale: int, rate: int) -> int:
    """time_math.pm: frame_number * scale * 1e6 / rate, truncated."""
    return (frame_number * scale * 1_000_000) // rate


def interleave_audio(n_vframes: int, v_rate: int, v_scale: int,
                     a_rate: int, a_scale: int) -> list:
    """Official pmp_muxer_avc interleaving (time_math.pm), exact integer math.

    Returns one dict per video frame:
        {'n_af': n_audio_frames, 'fd': first_delay, 'ld': last_delay,
         'a_start': index of the first audio frame of this video frame}

    Guarantees (what the PSP player expects, exactly time_math.pm):
        fd >= 0, ld > 0, n_af >= 1 as long as the fps is below the audio frame
        rate, and per packet
            first_delay + (t_a(last) - t_a(first)) + last_delay
                == video frame duration
        i.e. fd + (n_af - 1) audio steps + ld == v_dur up to floor rounding of
        the timestamps (the official muxer uses exact rational math; the naive
        fd + n_af*step + ld overshoots by one audio period, because last_delay
        is measured from the START of the last audio frame and already covers
        its playback time).
    Audio frames past the end of the stream get an empty payload, exactly like
    the reference muxer does (the player turns them into silence).
    """
    step = _time_of(1, a_scale, a_rate)
    out = []
    audio_number = 0            # next audio frame index
    next_audio_time = 0         # end time of audio frame (audio_number - 1)
    current_video_time = 0

    for i in range(n_vframes):
        a_start = audio_number
        last_time = current_video_time
        next_video_time = _time_of(i + 1, v_scale, v_rate)
        first_delay = 0
        count = 0

        while next_audio_time < next_video_time:
            if count == 0:
                first_delay = next_audio_time - last_time
            last_time = next_audio_time
            audio_number += 1
            next_audio_time = _time_of(audio_number, a_scale, a_rate)
            count += 1
            if step <= 0:       # degenerate rate, never loop forever
                break

        out.append({
            'n_af': count,
            'fd': max(0, first_delay),
            'ld': max(0, next_video_time - last_time),
            'a_start': a_start,
        })
        current_video_time = next_video_time

    return out

# --- PMP parse / build -------------------------------------------------------

def parse_pmp(data: bytes) -> dict:
    if len(data) < HDR_SIZE:
        die("file too small to be PMP")
    (magic, version,
     vid_format, n_vframes, width, height, vid_scale, vid_rate,
     aud_format, n_astreams, aud_max_frames, aud_scale, aud_rate, aud_stereo
    ) = struct.unpack_from('<14I', data, 0)

    if magic != PMP_MAGIC:
        die(f"not a PMP file (magic={hex(magic)})")
    if version != PMP_VERSION:
        die(f"unsupported PMP version: {version}")

    idx_off  = HDR_SIZE
    data_off = idx_off + n_vframes * 4
    index    = [struct.unpack_from('<I', data, idx_off + i*4)[0]
                for i in range(n_vframes)]

    packets = []
    pos = data_off
    for i in range(n_vframes):
        pkt_size = index[i] >> 1
        keyframe = index[i] & 1
        pkt = data[pos:pos+pkt_size]
        pos += pkt_size

        n_af = pkt[0]
        hn   = n_af * n_astreams + 3
        m    = struct.unpack_from(f'<{hn}I', pkt, 1)
        fd, ld, vlen = m[0], m[1], m[2]
        alens = list(m[3:])

        mhdr_sz = 1 + hn * 4
        vdata   = pkt[mhdr_sz:mhdr_sz+vlen]
        adata   = []
        apos    = mhdr_sz + vlen
        for al in alens:
            adata.append(pkt[apos:apos+al])
            apos += al

        packets.append({
            'kf': keyframe, 'n_af': n_af,
            'fd': fd, 'ld': ld,
            'size': pkt_size, 'vlen': vlen,
            'vdata': vdata, 'adata': adata
        })

    return {
        'magic': magic, 'version': version,
        'vid_format': vid_format, 'n_vframes': n_vframes,
        'width': width, 'height': height,
        'vid_scale': vid_scale, 'vid_rate': vid_rate,
        'aud_format': aud_format, 'n_astreams': n_astreams,
        'aud_max_frames': aud_max_frames,
        'aud_scale': aud_scale, 'aud_rate': aud_rate, 'aud_stereo': aud_stereo,
        'fps': (vid_rate / vid_scale) if vid_scale else 0,
        'packets': packets,
    }


def build_pmp(meta: dict, new_packets: list) -> bytes:
    n         = len(new_packets)
    n_astreams = meta['n_astreams']
    # the reference muxer never writes 0 here (players reject aud_max_frames 0)
    max_af    = max((p['n_af'] for p in new_packets), default=0) or 1

    hdr = struct.pack('<14I',
        meta['magic'], meta['version'],
        meta['vid_format'], n,
        meta['width'], meta['height'],
        meta['vid_scale'], meta['vid_rate'],
        meta['aud_format'], n_astreams, max_af,
        meta['aud_scale'], meta['aud_rate'], meta['aud_stereo'],
    )

    raw_packets = []
    new_index   = []
    for p in new_packets:
        vdata, adata = p['vdata'], p['adata']
        n_af = p['n_af']
        hn   = n_af * n_astreams + 3
        
        # adata can be list[bytes] or list[dict] with 'data' key
        audio_data = []
        for a in adata:
            if isinstance(a, dict):
                audio_data.append(a['data'])
            else:
                audio_data.append(a)
        
        mini = struct.pack(f'<B{hn}I',
            n_af, p['fd'], p['ld'], len(vdata),
            *[len(a) for a in audio_data]
        )
        raw = mini + vdata + b''.join(audio_data)
        raw_packets.append(raw)
        new_index.append((len(raw) << 1) | p['kf'])

    idx_data = b''.join(struct.pack('<I', x) for x in new_index)
    pkt_data = b''.join(raw_packets)
    return hdr + idx_data + pkt_data

# --- video encoding ----------------------------------------------------------

def x264_params(args, br: int = None) -> str:
    # PMP AVC settings, exact match of XviD4PSP 5 "x264 HQ Extreme" preset.
    # xvid4psp CLI: --crf 21 --level 3.0 --ref 2 --deblock -2:-1
    #   --direct none --no-b-adapt --no-8x8dct --no-weightb --weightp 0
    #   --pictiming --bframes 0 --trellis 2 --no-fast-pskip --no-dct-decimate
    #   --aud --partitions p8x8,b8x8,i4x4,p4x4 --me umh --subme 9
    p = f"level={args.level}:ref=2:bframes=0:b-adapt=0:direct=none"
    p += ":deblock=-2,-1"
    p += ":me=umh:subme=9:trellis=2:partitions=p8x8,b8x8,i4x4,p4x4"
    p += ":cabac=1:8x8dct=0:weightp=0:weightb=0"
    p += ":no-fast-pskip=1:no-dct-decimate=1"
    # HRD + per-frame pic_timing SEI, same AU structure as the ME-tested
    # reference PMPs (nal_hrd requires vbv in x264).
    p += ":aud=1:force-cfr=1:nal_hrd=vbr"
    p += f":vbv-maxrate={getattr(args, 'vbv_maxrate', 10000)}"
    p += f":vbv-bufsize={getattr(args, 'vbv_bufsize', 10000)}"
    if args.extra_x264:
        p += ":" + args.extra_x264.strip(':')
    return p


def normalize_startcodes(data: bytes) -> bytes:
    """Rewrite every Annex B start code to the 4 byte form 00 00 00 01.

    The reference muxer scans for `00 00 00 01 09` when it cuts frames, and a
    few encoders (ffmpeg's h264_mp4toannexb) emit 3 byte codes instead.
    Payload bytes are never touched.
    """
    nals = nal_units(data)
    if not nals or all(sc == 4 for _, _, _, sc in nals):
        return data
    out = bytearray(data[:nals[0][1]])
    for _, s, e, sc in nals:
        out += b'\x00\x00\x00\x01'
        out += data[s+sc:e]
    return bytes(out)


def reorder_nals_for_psp(h264_data: bytes) -> bytes:
    """Put the non-slice NALs of every access unit into the order the PSP
    decoder expects:  AUD -> SPS -> PPS -> SEI -> slice.

    x264 writes its info SEI in front of the AUD, the ffmpeg/libx264 fallback
    writes a pic-timing SEI right after the AUD (and one on every frame).
    Only AUD/SEI/SPS/PPS are moved, slice data is never touched, so this stays
    inside one access unit and keeps the byte count unchanged.
    """
    nals = nal_units(h264_data)
    if not nals:
        return h264_data

    out = bytearray()
    header = []

    def flush():
        if not header:
            return
        ordered = ([n for n in header if n[0] == 9] +          # AUD first
                   [n for n in header if n[0] == 7] +          # then SPS
                   [n for n in header if n[0] == 8] +          # then PPS
                   [n for n in header if n[0] not in (7, 8, 9)])  # SEI etc.
        for _, s, e, _ in ordered:
            out.extend(h264_data[s:e])
        del header[:]

    for ntype, start, end, _ in nals:
        if 1 <= ntype <= 5:          # slice -> close the header group
            flush()
            out.extend(h264_data[start:end])
        else:
            header.append((ntype, start, end, 0))
    flush()                          # trailing parameter sets (no slice)

    reordered = bytes(out)
    return reordered if len(reordered) == len(h264_data) else h264_data



class _BitWriter:
    def __init__(self):
        self.bits = []
    def write(self, v, n):
        for k in range(n - 1, -1, -1):
            self.bits.append((v >> k) & 1)
    def ue(self, v):
        code_num = v + 1
        l = code_num.bit_length()
        self.write(0, l - 1)
        self.write(code_num, l)
    def to_bytes(self):
        out = bytearray()
        for chunk in range(0, len(self.bits), 8):
            b = 0
            for bit in self.bits[chunk:chunk+8]:
                b = (b << 1) | bit
            b <<= (8 - len(self.bits[chunk:chunk+8]))
            out.append(b)
        return bytes(out)


class _BitReader:
    def __init__(self, data):
        self.bits = []
        for byte in data:
            self.bits.extend([(byte >> (7 - k)) & 1 for k in range(8)])
        self.i = 0
    def get(self, n):
        v = 0
        for _ in range(n):
            v = (v << 1) | self.bits[self.i]
            self.i += 1
        return v
    def ue(self):
        z = 0
        while self.bits[self.i] == 0:
            z += 1
            self.i += 1
        self.i += 1
        if z == 0:
            return 0
        return (1 << z) - 1 + self.get(z)


def parse_sps(sps: bytes):
    """Return dict of parsed SPS fields."""
    r = _BitReader(sps)
    out = {}
    out['profile_idc'] = r.get(8)
    out['constraint'] = r.get(8)
    out['level_idc'] = r.get(8)
    out['seq_parameter_set_id'] = r.ue()
    out['log2_max_frame_num_minus4'] = r.ue()
    # pic_order_cnt_type is ue(v) (H.264 7.3.2.1), not a fixed 2-bit field
    out['pic_order_cnt_type'] = r.ue()
    if out['pic_order_cnt_type'] == 0:
        out['log2_max_pic_order_cnt_lsb_minus4'] = r.ue()
    elif out['pic_order_cnt_type'] == 1:
        out['delta_pic_order_always_zero_flag'] = r.get(1)
        out['offset_for_non_ref_pic'] = r.ue()
        out['offset_for_top_to_bottom_field'] = r.ue()
        num = r.ue()
        out['num_ref_frames_in_pic_order_cnt_cycle'] = num
        out['offset_for_ref_frame'] = [r.ue() for _ in range(num)]
    out['max_num_ref_frames'] = r.ue()
    out['gaps_in_frame_num_value_allowed_flag'] = r.get(1)
    out['pic_width_in_mbs_minus1'] = r.ue()
    out['pic_height_in_map_units_minus1'] = r.ue()
    out['frame_mbs_only_flag'] = r.get(1)
    if not out['frame_mbs_only_flag']:
        out['mb_adaptive_frame_field_flag'] = r.get(1)
    out['direct_8x8_inference_flag'] = r.get(1)
    return out


def patch_sps_for_psp(h264_data: bytes) -> bytes:
    """Patch the first SPS NAL for PSP Media Engine compatibility.
    Rewrites log2_max_frame_num_minus4=4 and pic_order_cnt_type=1,
    matching xvid4psp reference SPS. Keeps dimensions and remaining fields.
    """
    i = 0
    while i < len(h264_data) - 3:
        if h264_data[i:i+3] == b'\x00\x00\x01' and (h264_data[i+3] & 0x1f) == 7:
            start = i
            end = i + 4
            while end < len(h264_data) - 3:
                if h264_data[end:end+3] in (b'\x00\x00\x01', b'\x00\x00\x00'):
                    break
                end += 1
            nal = h264_data[start:end]
            sps = nal[4:]
            try:
                f = parse_sps(sps)
                # Rewrite only up to and including direct_8x8_inference_flag,
                # then append ALL remaining bits verbatim.
                # To do that we locate the bit offset of the first remaining
                # field (which parse_sps consumed beyond it) by re-running a
                # targeted tokenizer that stops after direct_8x8_inference.
                r = _BitReader(sps)
                r.get(8); r.get(8); r.get(8)
                r.ue()          # seq_parameter_set_id
                r.ue()          # log2_max_frame_num_minus4 (patched value)
                poc_type = r.ue()
                if poc_type == 0:
                    r.ue()
                elif poc_type == 1:
                    r.get(1)
                    r.ue(); r.ue()
                    for _ in range(r.ue()):
                        r.ue()
                r.ue()          # max_num_ref_frames
                r.get(1)        # gaps flag
                r.ue()          # width
                r.ue()          # height
                frame_only = r.get(1)
                if not frame_only:
                    r.get(1)
                r.get(1)        # direct_8x8_inference
                # r.i is now the bit offset where the untouched remainder starts
                remainder_bits = r.bits[r.i:]

                w = _BitWriter()
                w.write(f['profile_idc'], 8)
                w.write(f['constraint'], 8)
                w.write(f['level_idc'], 8)
                w.ue(f['seq_parameter_set_id'])
                w.ue(4)              # log2_max_frame_num_minus4 = 4
                w.write(1, 2)        # pic_order_cnt_type = 1
                w.write(0, 1)        # delta_pic_order_always_zero_flag
                w.ue(0)              # offset_for_non_ref_pic
                w.ue(0)              # offset_for_top_to_bottom_field
                w.ue(0)              # num_ref_frames_in_pic_order_cnt_cycle
                w.ue(f['max_num_ref_frames'])
                w.write(f['gaps_in_frame_num_value_allowed_flag'], 1)
                w.ue(f['pic_width_in_mbs_minus1'])
                w.ue(f['pic_height_in_map_units_minus1'])
                w.write(f['frame_mbs_only_flag'], 1)
                if not f['frame_mbs_only_flag']:
                    w.write(f['mb_adaptive_frame_field_flag'], 1)
                w.write(f['direct_8x8_inference_flag'], 1)
                w.bits.extend(remainder_bits)

                new_sps = w.to_bytes()
                esc = bytearray()
                zeros = 0
                for bte in new_sps:
                    if zeros >= 2 and bte <= 3:
                        esc.append(3)
                        zeros = 0
                    if bte == 0:
                        zeros += 1
                    else:
                        zeros = 0
                    esc.append(bte)

                new_nal = nal[:4] + bytes(esc)
                return h264_data[:start] + new_nal + h264_data[end:]
            except Exception:
                return h264_data
        i += 1
    return h264_data


def _y4m_set_rate(path: str, rate: int, scale: int):
    """Force the frame rate of a y4m header.

    Used when the source is a raw Annex B stream: ffmpeg cannot know the rate
    from the PMP header and would declare 25 fps, which would leak into the
    SPS VUI and desync A/V on the PSP.
    """
    import re
    with open(path, 'rb') as f:
        data = f.read()
    nl = data.find(b'\n')
    if nl < 0:
        return
    hdr = data[:nl]
    new = re.sub(br'F[0-9]+:[0-9]+', b'F%d:%d' % (rate, scale), hdr)
    if new == hdr:
        if b' F' in hdr:
            return
        new = hdr + b' F%d:%d' % (rate, scale)
    with open(path, 'wb') as f:
        f.write(new + data[nl:])


def encode_video(src: str, width: int, height: int, fps,
                 args, tmp: str, verbose: bool,
                 video_mode: str = 'vbr',
                 video_bitrate: int = None,
                 annexb: bool = False,
                 rate: int = None, scale: int = None) -> list:
    """Encode src -> H.264 Annex B, return list[bytes] (one per frame).
    video_mode='vbr' -> CRF (quality-based)
    video_mode='cbr' -> constant bitrate, requires video_bitrate (kbps)

    annexb=True  -> src is already a raw Annex B elementary stream (PMP video
    packets).  Frame timing is passed through untouched so the frame count is
    preserved, and the y4m header is rewritten to rate/scale taken from the PMP
    header instead of the 25 fps ffmpeg guesses.

    Encoding backend:
      - built-in native x264 (bin/x264, built with --psp-compat) when present —
        produces the PSP reference SPS (log2_max_frame_num_minus4=5,
        pic_order_cnt_type=0) directly, no wine needed;
      - --x264-exe overrides the binary: a native (non-.exe) build is run
        directly with --psp-compat; a .exe is run via wine (legacy);
      - otherwise falls back to ffmpeg libx264 with the same xvid4psp preset.
    """
    ll   = 'warning' if verbose else 'error'
    mp4  = os.path.join(tmp, 'v.mp4')
    h264 = os.path.join(tmp, 'v.h264')

    vf = (f"scale={width}:{height}:force_original_aspect_ratio=decrease,"
          f"pad={width}:{height}:(ow-iw)/2:(oh-ih)/2")
    if getattr(args, 'deinterlace', False):
        vf = f"yadif," + vf

    def run_ffmpeg(base: list, tail: list):
        """ffmpeg run; in passthrough mode fall back to -vsync on old builds."""
        if not annexb:
            if fps:
                base = base + ['-r', str(fps)]
            subprocess.run(base + tail, check=True)
            return
        try:
            subprocess.run(base + ['-fps_mode', 'passthrough'] + tail, check=True)
        except subprocess.CalledProcessError:
            subprocess.run(base + ['-vsync', '0'] + tail, check=True)

    x264_exe = getattr(args, 'x264_exe', None)
    if not x264_exe:
        bundled = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'bin', 'x264')
        if os.path.isfile(bundled) and os.access(bundled, os.X_OK):
            x264_exe = bundled

    use_native = bool(x264_exe) and not str(x264_exe).lower().endswith('.exe')

    if x264_exe:
        # --- real x264, exact XviD4PSP 5 "x264 HQ Extreme" preset --------
        # Native build runs directly with --psp-compat (reference SPS);
        # a Windows .exe is run via wine (legacy).
        y4m  = os.path.join(tmp, 'v.y4m')
        run_ffmpeg(
            ['ffmpeg', '-y', '-hide_banner', '-loglevel', ll,
             '-i', src, '-map', '0:v:0', '-vf', vf],
            ['-f', 'yuv4mpegpipe', y4m])
        if annexb:
            _y4m_set_rate(y4m, rate or 25000, scale or 1000)

        preset = str(getattr(args, 'preset', 'slow'))
        x264_cli = [
            # XviD4PSP "x264 HQ Extreme" produced Main/CABAC + HRD VUI with
            # per-frame pic-timing SEIs — every ME-tested reference PMP is
            # profile_idc=77 cabac=1 nal_hrd=1.  Baseline/CAVLC encodes decode
            # fine in ffmpeg/PPSSPP but hang the real ME ~5s in (first mid-GOP
            # IDR, pkt#162): keep Main, never ship baseline to hardware.
            '--preset', preset,
            '--profile', str(getattr(args, 'profile', 'main')), '--level', '3.0', '--ref', '2', '--deblock', '-2:-1',
            '--direct', 'none', '--no-b-adapt',
            '--no-8x8dct', '--no-weightb', '--weightp', '0',
            '--bframes', '0',
            # ultrafast/superfast would drop CABAC (CAVLC hangs the real ME)
            '--cabac',
            '--aud',
            '--keyint', str(getattr(args, 'keyint', 250)),
        ]
        if preset == 'slow':
            # the original XviD4PSP HQ-Extreme speed/quality knobs; faster
            # presets use their own me/subme/trellis instead (2.5-5x encode)
            x264_cli += ['--trellis', '2',
                         '--no-fast-pskip', '--no-dct-decimate',
                         '--partitions', 'p8x8,b8x8,i4x4,p4x4',
                         '--me', 'umh', '--subme', '9']
        if use_native:
            # HRD in the VUI makes x264 emit buffering_period + per-frame
            # pic_timing SEIs, the exact AU structure the reference files
            # carry.  XviD4PSP encoded every reference PMP with
            # --nal-hrd vbr --vbv-maxrate 10000 --vbv-bufsize 10000
            # (decoded HRD of all 11 mcsm PMPs: 10000128 bps / 10000128 bits).
            # No --pic-struct: the reference SPS has pic_struct_present=0.
            x264_cli += ['--psp-compat',
                         '--nal-hrd', 'vbr',
                         '--vbv-maxrate', str(getattr(args, 'vbv_maxrate', 10000)),
                         '--vbv-bufsize', str(getattr(args, 'vbv_bufsize', 10000))]
        else:
            # legacy .exe (2009 build) has --pictiming but no --psp-compat
            x264_cli += ['--pictiming']

        if video_mode == 'cbr':
            if not video_bitrate:
                die("--video-bitrate is required for --video-mode cbr")
            x264_cli += ['--bitrate', str(video_bitrate)]
        else:
            x264_cli += ['--crf', str(args.crf)]

        # --extra-x264 is appended last so it overrides the preset above,
        # e.g. "subme=6:me=hex:trellis=1" is a 1.6x faster encode at the
        # same bitrate (key=value pairs, ':' separated).
        extra = str(getattr(args, 'extra_x264', '') or '').strip().strip(':')
        for opt in (o.strip() for o in extra.split(':')):
            if not opt:
                continue
            x264_cli.append(opt if opt.startswith('-') else '--' + opt)

        runner = [str(x264_exe)] if use_native else ['wine', str(x264_exe)]
        subprocess.run(
            [*runner, *x264_cli, '-o', h264, y4m],
            check=True)
    else:
        # --- ffmpeg libx264 with the same xvid4psp preset ---------------
        if video_mode == 'cbr':
            if not video_bitrate:
                die("--video-bitrate is required for --video-mode cbr")
            br = video_bitrate
            rate_args = [
                '-b:v', f'{br}k',
                '-minrate', f'{br}k',
                '-maxrate', f'{br}k',
                '-bufsize', f'{br*2}k',
            ]
        else:
            br = None
            rate_args = ['-crf', str(args.crf)]

        run_ffmpeg(
            ['ffmpeg', '-y', '-hide_banner', '-loglevel', ll,
             '-i', src,
             '-map', '0:v:0',
             '-c:v', 'libx264', '-preset', args.preset,
             '-g', str(args.keyint),
             '-vf', vf,
             *rate_args,
             '-x264-params', x264_params(args, br), '-an'],
            [mp4])

        # Convert to Annex B and reorder NALs: move initial SEI after PPS
        subprocess.run([
            'ffmpeg', '-y', '-hide_banner', '-loglevel', 'error',
            '-i', mp4, '-c:v', 'copy',
            '-bsf:v', 'h264_mp4toannexb', '-f', 'h264', h264
        ], check=True)

    # 4 byte start codes + PSP NAL order (AUD -> SPS -> PPS -> SEI -> slice)
    # BEFORE probing, so the packet positions ffprobe reports describe the
    # exact bytes we slice out.
    with open(h264, 'rb') as f:
        raw = f.read()
    cleaned = reorder_nals_for_psp(normalize_startcodes(raw))
    if cleaned != raw:
        with open(h264, 'wb') as f:
            f.write(cleaned)
        raw = cleaned

    res = subprocess.run([
        'ffprobe', '-v', 'quiet',
        '-select_streams', 'v:0',
        '-show_packets', '-print_format', 'json', h264
    ], capture_output=True, text=True, check=True)

    pkts = json.loads(res.stdout)['packets']

    frames = []
    for p in pkts:
        pos  = int(p['pos'])
        size = int(p['size'])
        frames.append(raw[pos:pos+size])
    return frames

# --- audio extraction / re-encode --------------------------------------------

def _aac_rate_args(audio_mode: str, audio_bitrate: int, audio_quality: float) -> list:
    if audio_mode == 'vbr':
        return ['-q:a', str(audio_quality)]
    else:
        return ['-b:a', f'{audio_bitrate}k']


def _audio_channels(args) -> tuple:
    """Return (ac, aud_stereo) from --audio-channels."""
    if args.audio_channels == 'mono':
        return 1, 0
    return 2, 1


def extract_audio(src: str, tmp: str, aud_rate: int, ac: int,
                  audio_mode: str, audio_bitrate: int,
                  audio_quality: float, verbose: bool) -> list:
    """Extract/re-encode audio from any source -> ADTS AAC.
    Returns list of dicts {data, pts_us}."""
    ll  = 'warning' if verbose else 'error'
    aac = os.path.join(tmp, 'a.aac')

    subprocess.run([
        'ffmpeg', '-y', '-hide_banner', '-loglevel', ll,
        '-i', src, '-vn',
        '-c:a', 'aac', '-ar', str(aud_rate), '-ac', str(ac),
        *_aac_rate_args(audio_mode, audio_bitrate, audio_quality),
        '-flags:a', '+bitexact',
        aac
    ], check=True)

    return _aac_frames(aac)


def extract_raw_audio_from_pmp(pmp_data: bytes, meta: dict) -> list:
    """Extract raw audio frames directly from PMP without re-encoding.
    Returns list of {data, pts_us} - preserves original audio data."""
    packets = parse_pmp(pmp_data)['packets']
    
    frames = []
    frame_idx = 0
    aac_dur_us = int(1024 * 1_000_000 / meta['aud_rate'])
    
    for pkt in packets:
        for adata in pkt['adata']:
            if len(adata) > 0:
                pts_us = frame_idx * aac_dur_us
                frames.append({'data': adata, 'pts_us': pts_us})
                frame_idx += 1
    
    return frames


def recompress_audio_from_pmp(pmp_path: str, tmp: str, aud_rate: int, ac: int,
                              audio_mode: str, audio_bitrate: int,
                              audio_quality: float, verbose: bool) -> list:
    """Re-encode audio from PMP file -> ADTS AAC.
    Uses ffmpeg's built-in PMP demuxer to extract audio correctly.
    Returns list of {data, pts_us}."""
    ll = 'warning' if verbose else 'error'
    reenc = os.path.join(tmp, 'reenc_a.aac')

    try:
        subprocess.run([
            'ffmpeg', '-y', '-hide_banner', '-loglevel', ll,
            '-i', pmp_path,
            '-map', '0:a:0', '-vn',
            '-c:a', 'aac', '-ar', str(aud_rate), '-ac', str(ac),
            *_aac_rate_args(audio_mode, audio_bitrate, audio_quality),
            '-flags:a', '+bitexact',
            reenc
        ], check=True, capture_output=True)

        return _aac_frames(reenc)
    except subprocess.CalledProcessError as e:
        log(f"  warning: audio re-encode failed: {e}", verbose)
        log(f"  keeping original audio unchanged", verbose)
        return []


def _aac_frames(aac_path: str) -> list:
    """Parse ADTS AAC file -> list of {data, pts_us}."""
    return _frames_from_file(aac_path, strip=7)


def _frames_from_file(path: str, strip: int = 0) -> list:
    """Split a raw ADTS/MP3 stream into codec frames using ffprobe packets.

    strip=7 removes the ADTS header (PSP wants raw AAC frames),
    strip=0 keeps MP3 frames as they are (they are already self contained).
    """
    res = subprocess.run([
        'ffprobe', '-v', 'quiet',
        '-select_streams', 'a:0',
        '-show_packets', '-print_format', 'json', path
    ], capture_output=True, text=True, check=True)

    pkts = json.loads(res.stdout).get('packets', [])
    with open(path, 'rb') as f:
        raw = f.read()

    frames = []
    for p in pkts:
        if p.get('pos', '-1') in ('-1', 'N/A'):
            continue
        pos   = int(p['pos'])
        size  = int(p['size'])
        pts_s = float(p.get('pts_time') or p.get('dts_time') or '0')
        if size > strip:
            data = raw[pos+strip:pos+size]
        elif strip:
            data = raw[pos:pos+size]  # fallback if frame is too small
        else:
            data = raw[pos:pos+size]
        frames.append({'data': data, 'pts_us': int(pts_s * 1e6)})
    return frames


# --- raw AAC / MP3 helpers --------------------------------------------------

_AAC_RATES = [96000, 88200, 64000, 48000, 44100, 32000, 24000,
              22050, 16000, 12000, 11025, 8000, 7350]


def adts_header(frame_len: int, rate: int, channels: int, profile: int = 1) -> bytes:
    """7 byte ADTS header (MPEG-4, no CRC) for a raw AAC-LC frame."""
    try:
        fi = _AAC_RATES.index(rate)
    except ValueError:
        fi = 4
    hl = frame_len + 7
    return bytes([
        0xFF, 0xF1,
        ((profile & 3) << 6) | (fi << 2) | ((channels >> 2) & 1),
        ((channels & 3) << 6) | ((hl >> 11) & 3),
        (hl >> 3) & 0xFF,
        ((hl & 7) << 5) | 0x1F,
        0xFC,
    ])


def reencode_audio_frames(aframes: list, meta: dict, args, tmp: str,
                          verbose: bool, tag: str = '') -> list:
    """Re-encode the raw audio frames taken straight out of a PMP.

    aframes: list of raw codec frames (bytes).  The codec always follows the
    container header so the file stays what it was: aud_format 1 (AAC) is
    wrapped in ADTS for decoding, aud_format 0 (MP3) is already a raw stream.
    Returns a list of raw frames (bytes) or [] when the re-encode failed, in
    which case the caller keeps the original frames.
    """
    if not aframes:
        return []

    afmt     = meta['aud_format']
    rate     = meta['aud_rate']
    channels = 2 if meta['aud_stereo'] else 1
    ll       = 'warning' if verbose else 'error'

    if afmt == 1:
        payload = b''.join(adts_header(len(a), rate, channels) + a for a in aframes)
        src, dst = os.path.join(tmp, f'a{tag}_in.aac'), os.path.join(tmp, f'a{tag}_out.aac')
        codec, strip = ['-c:a', 'aac'], 7
        fmt = ['-f', 'adts']
    elif afmt == 0:
        payload = b''.join(aframes)
        src, dst = os.path.join(tmp, f'a{tag}_in.mp3'), os.path.join(tmp, f'a{tag}_out.mp3')
        codec, strip = ['-c:a', 'libmp3lame'], 0
        fmt = ['-f', 'mp3']
    else:
        log(f"  warning: unknown aud_format {afmt}, keeping original audio", verbose)
        return []

    if not payload:
        return []

    with open(src, 'wb') as f:
        f.write(payload)

    mode = getattr(args, 'audio_mode', 'cbr')
    rate_args = _aac_rate_args(mode, getattr(args, 'audio_bitrate', 96),
                               getattr(args, 'audio_quality', 2.0))

    cmd = ['ffmpeg', '-y', '-hide_banner', '-loglevel', ll,
           '-i', src, *fmt] + codec + [
           '-ar', str(rate), '-ac', str(channels), *rate_args,
           '-flags:a', '+bitexact', dst]
    try:
        subprocess.run(cmd, check=True, capture_output=True)
    except subprocess.CalledProcessError as e:
        err = (e.stderr or b'').decode(errors='replace')[:200]
        log(f"  warning: audio re-encode failed: {err}", verbose)
        log("  keeping original audio unchanged", verbose)
        return []

    try:
        frames = [f['data'] for f in _frames_from_file(dst, strip=strip)]
    except (subprocess.CalledProcessError, KeyError, json.JSONDecodeError,
            IndexError):
        frames = []

    if not frames:
        log("  warning: audio re-encode produced no frames, keeping original audio",
            verbose)
        return []
    return frames



def psp_warnings(meta: dict, packets: list) -> list:
    """Validate the container against the reference muxer / PSP player rules."""
    w = []
    vfmt, wdt, hgt = meta['vid_format'], meta['width'], meta['height']
    vscale, vrate = meta['vid_scale'], meta['vid_rate']
    afmt, nas = meta['aud_format'], meta['n_astreams']
    amax, ascale = meta['aud_max_frames'], meta['aud_scale']
    arate, stereo = meta['aud_rate'], meta['aud_stereo']

    if vfmt not in (0, 1):
        w.append(f"vid_format {vfmt} is not 0 (MPEG-4) or 1 (H.264)")
    if wdt % 16 or hgt % 16:
        w.append(f"resolution {wdt}x{hgt} must be a multiple of 16")
    if vfmt == 1 and (wdt > 480 or hgt > 272):
        w.append(f"resolution {wdt}x{hgt} exceeds the PSP AVC limit 480x272")
    if vscale == 0 or vrate == 0:
        w.append("vid_scale/vid_rate must not be 0")
    elif vrate < vscale:
        w.append("vid_rate < vid_scale")
    if vscale > 0xffffff:
        w.append("vid_scale > 0xffffff")

    fps = (vrate / vscale) if vscale else 0
    # All known-good XviD4PSP reference encodes are 29.97fps and play fine on
    # the real ME -- only flag rates above that ceiling (spec allows up to ~38).
    if fps > 29.98:
        w.append(f"fps {fps:.2f} > 29.97 (reference encodes are 29.97fps max; "
                 f"the PSP Media Engine cannot sustain anything above it)")

    if nas:
        if amax == 0:
            w.append("aud_max_frames is 0 (players reject the file)")
        if afmt not in (0, 1):
            w.append(f"aud_format {afmt} is not 0 (MP3) or 1 (AAC)")
        if afmt == 1 and ascale != 1024:
            w.append(f"AAC aud_scale {ascale} != 1024 (decoder buffer math breaks)")
        if afmt == 0 and ascale != 1152:
            w.append(f"MP3 aud_scale {ascale} != 1152 (decoder buffer math breaks)")
        if arate != 44100:
            w.append(f"aud_rate {arate} != 44100 (reference player only accepts 44100)")
        if stereo != 1:
            w.append("aud_stereo != 1 (reference player only accepts stereo)")
        if fps and (arate / ascale) <= fps:
            w.append(f"fps {fps:.2f} >= audio frame rate {arate/ascale:.2f}: "
                     "some video frames would carry no audio frame")
    else:
        w.append("no audio stream (reference players require at least one)")

    dur = _time_of(1, vscale, vrate) if vscale else 0
    max_naf = max((p['n_af'] for p in packets), default=0)
    if max_naf > 255:
        w.append(f"{max_naf} audio frames in one packet > 255 (does not fit the uint8)")
    if nas and amax and max_naf > amax:
        w.append(f"packet carries {max_naf} audio frames but header says {amax} "
                 "-> heap overflow in the player")
    if nas and any(p['n_af'] == 0 for p in packets):
        w.append("some video frames carry no audio frame "
                 "(the official muxer refuses such files)")

    bad_delay = [i for i, p in enumerate(packets)
                 if p['fd'] > dur or p['ld'] > dur]
    if bad_delay:
        w.append(f"first_delay/last_delay exceed the frame duration in "
                 f"{len(bad_delay)} packets (A/V desync, up to a stall on PSP)")

    no_aud = 0
    bad_kf = 0
    for p in packets:
        nals = nal_units(p['vdata'])
        if nals and nals[0][0] != 9:
            no_aud += 1
        if any(t == 5 for t, *_ in nals) and not keyframe_flag(p['vdata']):
            bad_kf += 1
    if no_aud:
        w.append(f"{no_aud} packets do not start with an AUD NAL "
                 "(sceMpegAvcDecode expects one access unit per packet)")
    if bad_kf:
        w.append(f"{bad_kf} IDR packets cannot be used as a seek point "
                 "(an SEI sits between the AUD and the SPS, or the SPS is "
                 "missing) - the reference muxer only flags "
                 "AUD(primary_pic_type=0) + SPS as keyframe")

    big = [i for i, p in enumerate(packets) if len(p['vdata']) > MAX_AU_SIZE]
    if big:
        w.append(f"{len(big)} video packets larger than {MAX_AU_SIZE} bytes - "
                 "the reference player DMAs the AU into the fixed ME buffer "
                 "at 0x4a000, oversized AUs corrupt memory on real hardware")

    return w

# --- subcommands -------------------------------------------------------------

def _stream_flags(args) -> tuple:
    """Return (do_video, do_audio) based on --stream flag."""
    s = getattr(args, 'stream', 'both')
    return (s in ('video', 'both')), (s in ('audio', 'both'))


def do_compress(src: str, dst: str, args, verbose: bool):
    """PMP -> PMP, directly on the container: no intermediate MP4, no decode.

    * video packets are pulled out of the file as raw Annex B and handed to the
      encoder as an elementary stream (--stream video/both), otherwise they are
      copied byte for byte;
    * audio frames stay byte identical unless they are re-encoded in the codec
      the header declares (--stream audio/both);
    * the header (resolution, timing, audio format) is inherited from the
      source file instead of being recomputed;
    * audio/video interleaving uses the official pmp_muxer_avc algorithm, so
      first_delay + audio + last_delay == frame duration for every packet.
    """
    args.preset = resolve_preset(args.preset)
    log(f"compress: {src} -> {dst}", verbose)

    raw   = open(src, 'rb').read()
    meta  = parse_pmp(raw)
    do_vid, do_aud = _stream_flags(args)

    if not meta['packets']:
        die("input PMP has no packets")

    covered = (HDR_SIZE + meta['n_vframes'] * 4
               + sum(p['size'] for p in meta['packets']))
    if covered != len(raw):
        die(f"corrupt PMP: index covers {covered} bytes but the file is {len(raw)}")
    if not meta['vid_rate'] or not meta['vid_scale']:
        die("invalid PMP header: video scale/rate must not be 0")
    if meta['n_astreams'] and not meta['aud_rate']:
        die("invalid PMP header: aud_rate must not be 0")

    width  = args.width  if args.width  is not None else meta['width']
    height = args.height if args.height is not None else meta['height']
    width  -= width  % 16
    height -= height % 16
    if width <= 0 or height <= 0:
        die("--width/--height must be positive")
    if not do_vid and (width != meta['width'] or height != meta['height']):
        die("--width/--height needs the video re-encoded (--stream video/both)")

    fps     = meta['fps']
    v_rate  = meta['vid_rate']
    v_scale = meta['vid_scale']
    n_src   = meta['n_vframes']
    stream  = ('video' if do_vid and not do_aud else
               'audio' if do_aud and not do_vid else 'both')
    log(f"  {width}x{height} @ {fps:.2f}fps  {n_src} frames  "
        f"[stream={stream}]", verbose)

    src_mb = os.path.getsize(src) / 1048576
    tmp = tempfile.mkdtemp(prefix='pmpcli_')
    try:
        # --- video: raw Annex B straight out of the container --------------
        if do_vid:
            es = os.path.join(tmp, 'in.h264')
            with open(es, 'wb') as f:
                f.write(b''.join(p['vdata'] for p in meta['packets']))
            new_v = encode_video(
                es, width, height, fps, args, tmp, verbose,
                video_mode=getattr(args, 'video_mode', 'vbr'),
                video_bitrate=getattr(args, 'video_bitrate', None),
                annexb=True, rate=v_rate, scale=v_scale)
            if len(new_v) != n_src:
                log(f"  warning: video frame count changed {n_src} -> {len(new_v)}",
                    verbose)
            log(f"  video: {len(new_v)} frames re-encoded  "
                f"[{getattr(args, 'video_mode', 'vbr')}]", verbose)
        else:
            new_v = [normalize_startcodes(p['vdata'])
                     for p in meta['packets']]
            log(f"  video: {n_src} frames copied", verbose)

        # --- audio: raw frames stay raw unless re-encoded ------------------
        src_nastreams = meta['n_astreams']
        n_astreams = 0 if args.no_audio else src_nastreams
        streams = []
        if n_astreams:
            for s in range(src_nastreams):
                streams.append([a for p in meta['packets']
                                for a in p['adata'][s::src_nastreams]])
            if do_aud:
                for i, st in enumerate(streams):
                    new = reencode_audio_frames(st, meta, args, tmp, verbose,
                                                tag=f'_{i}')
                    if new:
                        streams[i] = new
            codec = 'AAC' if meta['aud_format'] == 1 else 'MP3'
            log(f"  audio: {sum(len(s) for s in streams)} frames "
                f"{'re-encoded' if do_aud else 'copied'}  [{codec}]", verbose)

        # --- interleave exactly like the official muxer --------------------
        n_v = len(new_v)
        frame_dur = _time_of(1, v_scale, v_rate)
        if n_astreams and streams and streams[0]:
            plan = interleave_audio(n_v, v_rate, v_scale,
                                    meta['aud_rate'], meta['aud_scale'])
        else:
            plan = [{'n_af': 0, 'fd': 0, 'ld': frame_dur, 'a_start': 0}
                    for _ in range(n_v)]

        new_pkts = []
        for i, vd in enumerate(new_v):
            p = plan[i]
            adata = []
            for st in streams:
                for j in range(p['a_start'], p['a_start'] + p['n_af']):
                    adata.append(st[j] if j < len(st) else b'')
            new_pkts.append({
                'kf':   1 if keyframe_flag(vd) else 0,
                'n_af': p['n_af'],
                'fd':   p['fd'],
                'ld':   p['ld'],
                'vdata': vd,
                'adata': adata,
            })

        out_meta = dict(meta)
        out_meta.update({
            'n_vframes': n_v,
            'width': width, 'height': height,
            'n_astreams': n_astreams,
            'aud_max_frames': max([p['n_af'] for p in new_pkts] + [1]),
        })
        if n_astreams == 0:
            out_meta['aud_stereo'] = 0

        for msg in psp_warnings(out_meta, new_pkts):
            log(f"  warning: {msg}", verbose)

        out = build_pmp(out_meta, new_pkts)
        parent = os.path.dirname(os.path.abspath(dst))
        if parent:
            os.makedirs(parent, exist_ok=True)
        with open(dst, 'wb') as f:
            f.write(out)

        dst_mb = len(out) / 1048576
        smaller = ""
        if src_mb:
            delta = 100 * (1 - dst_mb / src_mb)
            smaller = f"  ({delta:.1f}% {'smaller' if delta >= 0 else 'larger'})"
        log(f"  {src_mb:.2f} MB -> {dst_mb:.2f} MB{smaller}", verbose)
    finally:
        if not args.keep_temp:
            shutil.rmtree(tmp, ignore_errors=True)
        else:
            log(f"  temp: {tmp}", verbose)


def do_convert(src: str, dst: str, args, verbose: bool):
    """MP4 (or any video) -> PMP."""
    log(f"convert: {src} -> {dst}", verbose)
    args.preset = resolve_preset(args.preset)

    mode_v = getattr(args, 'video_mode', 'vbr')
    mode_a = getattr(args, 'audio_mode', 'cbr')
    vbr_v  = getattr(args, 'video_bitrate', None)
    aq     = getattr(args, 'audio_quality', 2.0)
    ac, aud_stereo = _audio_channels(args)

    res = subprocess.run([
        'ffprobe', '-v', 'quiet',
        '-print_format', 'json', '-show_streams', src
    ], capture_output=True, text=True, check=True)
    streams = json.loads(res.stdout)['streams']

    has_audio = any(s['codec_type'] == 'audio' for s in streams)
    vstream   = next((s for s in streams if s['codec_type'] == 'video'), None)
    if not vstream:
        die(f"no video stream in {src}")

    # FPS: PMP spec allows 1..~38, but >29.97fps is not recommended.
    # --fps is capped at FPS_MAX; default is source fps (or FPS_MAX if higher).
    if args.fps:
        if args.fps <= 0:
            die("--fps must be > 0")
        fps = min(args.fps, FPS_MAX)
    else:
        fr = vstream.get('r_frame_rate', '30/1')
        try:
            a, b = fr.split('/')
            src_fps = float(a) / float(b)
        except (ValueError, ZeroDivisionError):
            src_fps = 0
        fps = min(FPS_MAX, src_fps) if src_fps else FPS_MAX

    src_w = int(vstream.get('width',  DEF_W)) or DEF_W
    src_h = int(vstream.get('height', DEF_H)) or DEF_H
    src_w -= src_w % 16          # PSP wants multiples of 16
    src_h -= src_h % 16

    # An omitted width/height keeps the source dimensions.
    width  = src_w if args.width  is None else args.width
    height = src_h if args.height is None else args.height
    width  -= width  % 16
    height -= height % 16
    if width <= 0 or height <= 0:
        die("--width/--height must be positive")

    vid_scale = 1000
    vid_rate  = round(fps * 1000)

    aud_rate   = args.audio_rate
    aud_format = 1
    n_astreams = 1 if has_audio and not args.no_audio else 0
    aud_scale  = 1024   # AAC frame size in samples
    if n_astreams == 0:
        aud_stereo = 0

    tmp = tempfile.mkdtemp(prefix='pmpcli_')
    try:
        new_vframes = encode_video(
            src, width, height, fps,
            args, tmp, verbose,
            video_mode=mode_v, video_bitrate=vbr_v
        )
        n_vframes = len(new_vframes)
        log(f"  video: {n_vframes} frames @ {fps:.3f}fps  "
            f"{width}x{height}  [{mode_v}]", verbose)

        aframes = []
        if n_astreams > 0:
            aframes = extract_audio(src, tmp, aud_rate, ac,
                                    mode_a, args.audio_bitrate, aq, verbose)
            log(f"  audio: {len(aframes)} AAC frames  [{mode_a}]", verbose)

        # Official pmp_muxer_avc interleaving: first_delay + audio + last_delay
        # is exactly one video frame duration for every packet.
        if n_astreams > 0 and aframes:
            plan = interleave_audio(n_vframes, vid_rate, vid_scale,
                                    aud_rate, aud_scale)
        else:
            frame_dur = _time_of(1, vid_scale, vid_rate)
            plan = [{'n_af': 0, 'fd': 0, 'ld': frame_dur, 'a_start': 0}
                    for _ in range(n_vframes)]

        new_pkts = []
        for i in range(n_vframes):
            vd = new_vframes[i]
            p  = plan[i]
            adata = []
            if n_astreams:
                adata = [aframes[j]['data'] if j < len(aframes) else b''
                         for j in range(p['a_start'], p['a_start'] + p['n_af'])]
            new_pkts.append({
                'kf':   1 if keyframe_flag(vd) else 0,
                'n_af': p['n_af'],
                'fd':   p['fd'],
                'ld':   p['ld'],
                'vdata': vd,
                'adata': adata,
            })

        max_af = max((p['n_af'] for p in new_pkts), default=0)
        meta = {
            'magic': PMP_MAGIC, 'version': PMP_VERSION,
            'vid_format': 1,
            'n_vframes': n_vframes,
            'width': width, 'height': height,
            'vid_scale': vid_scale, 'vid_rate': vid_rate,
            'aud_format': aud_format, 'n_astreams': n_astreams,
            'aud_max_frames': max(max_af, 1),
            'aud_scale': aud_scale, 'aud_rate': aud_rate,
            'aud_stereo': aud_stereo,
            'fps': fps,
        }

        for msg in psp_warnings(meta, new_pkts):
            log(f"  warning: {msg}", verbose)

        out = build_pmp(meta, new_pkts)
        os.makedirs(os.path.dirname(os.path.abspath(dst)), exist_ok=True)
        with open(dst, 'wb') as f:
            f.write(out)
        log(f"  {len(out)/1048576:.2f} MB -> {dst}", verbose)
    finally:
        if not args.keep_temp:
            shutil.rmtree(tmp, ignore_errors=True)
        else:
            log(f"  temp: {tmp}", verbose)


def do_decode(src: str, dst: str, args, verbose: bool):
    """PMP -> MP4: decode to a playable MP4 (re-encode h264 + aac).

    ffmpeg's pmp demuxer can't stream-copy (video packets come out empty
    and AAC isn't fully parsed), so both streams are re-encoded.
    """
    log(f"decode: {src} -> {dst}", verbose)
    ll = 'warning' if verbose else 'error'

    res = subprocess.run([
        'ffprobe', '-v', 'error',
        '-print_format', 'json', '-show_streams', src
    ], capture_output=True, text=True)
    if res.returncode != 0:
        die(f"ffprobe failed on {src}")
    streams = json.loads(res.stdout).get('streams', [])

    has_video = any(s['codec_type'] == 'video' for s in streams)
    has_audio = any(s['codec_type'] == 'audio' for s in streams)
    do_video  = has_video and not args.no_video
    do_audio  = has_audio and not args.no_audio

    if not do_video and not do_audio:
        die("nothing to decode (no matching streams / --no-video --no-audio)")
    if not has_video:
        log("  no video stream in source", verbose)
    if not has_audio:
        log("  no audio stream in source", verbose)

    cmd = ['ffmpeg', '-y', '-hide_banner', '-loglevel', ll, '-i', src]
    if do_video:
        cmd += ['-map', '0:v:0', '-c:v', 'libx264',
                '-preset', args.preset, '-crf', str(args.crf),
                '-pix_fmt', 'yuv420p']
    else:
        cmd += ['-vn']
    if do_audio:
        cmd += ['-map', '0:a:0', '-c:a', 'aac',
                '-b:a', f'{args.audio_bitrate}k']
    else:
        cmd += ['-an']
    cmd += ['-movflags', '+faststart', dst]

    subprocess.run(cmd, check=True)

    src_mb = os.path.getsize(src)  / 1048576
    dst_mb = os.path.getsize(dst)  / 1048576
    log(f"  {src_mb:.2f} MB PMP -> {dst_mb:.2f} MB MP4", verbose)

# --- batch -------------------------------------------------------------------

def collect_files(paths: list, recursive: bool, mode: str) -> list:
    """Collect input files from paths (files or dirs)."""
    exts = {
        'compress': {'.pmp'},
        'convert':  {'.mp4', '.mkv', '.avi', '.mov', '.flv', '.webm'},
        'both':     {'.pmp', '.mp4', '.mkv', '.avi', '.mov', '.flv', '.webm'},
    }[mode]

    result = []
    for p in paths:
        if os.path.isfile(p):
            if os.path.splitext(p)[1].lower() in exts:
                result.append(os.path.abspath(p))
        elif os.path.isdir(p):
            pattern = '**/*' if recursive else '*'
            for ext in exts:
                for fp in glob.glob(os.path.join(p, pattern + ext),
                                    recursive=recursive):
                    result.append(os.path.abspath(fp))
        else:
            print(f"skip: not found: {p}", file=sys.stderr)
    return sorted(set(result))


def batch_output(src: str, batch_mode: str, args) -> str:
    """Determine output path for a batch item."""
    base, ext = os.path.splitext(src)
    if batch_mode == 'compress':
        out_name = base + args.suffix + '.pmp'
    else:
        out_name = base + '.pmp'

    if args.output_dir:
        out_name = os.path.join(args.output_dir,
                                os.path.basename(out_name))
    return out_name


def cmd_convert(args):
    src = os.path.expanduser(args.input)
    dst = os.path.expanduser(args.output) if args.output else None
    dst = dst or (os.path.splitext(src)[0] + '.pmp')
    do_convert(src, dst, args, verbose=not args.quiet)


def cmd_compress(args):
    src = os.path.expanduser(args.input)
    dst = os.path.expanduser(args.output) if args.output else None
    dst = dst or (os.path.splitext(src)[0] + args.suffix + '.pmp')
    do_compress(src, dst, args, verbose=not args.quiet)


def cmd_decode(args):
    src = os.path.expanduser(args.input)
    dst = os.path.expanduser(args.output) if args.output else None
    dst = dst or (os.path.splitext(src)[0] + '.mp4')
    do_decode(src, dst, args, verbose=not args.quiet)


def cmd_batch(args):
    batch_mode = args.batch_mode   # compress | convert
    args.paths = [os.path.expanduser(p) for p in args.paths]
    files = collect_files(args.paths, args.recursive, batch_mode)

    if not files:
        die("no matching files")

    print(f"batch: {len(files)} files ({batch_mode})")
    if args.dry_run:
        for f in files:
            print(f"  {f} -> {batch_output(f, batch_mode, args)}")
        return

    ok = fail = 0
    for i, src in enumerate(files, 1):
        dst = batch_output(src, batch_mode, args)
        print(f"[{i}/{len(files)}] {os.path.basename(src)}")

        if args.replace:
            tmp_dst = dst + '.pmctmp'
            real_dst = src if batch_mode == 'compress' else dst
            try:
                if batch_mode == 'compress':
                    do_compress(src, tmp_dst, args, verbose=not args.quiet)
                else:
                    do_convert(src, tmp_dst, args, verbose=not args.quiet)
                shutil.move(tmp_dst, real_dst)
                ok += 1
            except Exception as e:
                print(f"  error: {e}", file=sys.stderr)
                if os.path.exists(tmp_dst):
                    os.remove(tmp_dst)
                fail += 1
        else:
            try:
                if batch_mode == 'compress':
                    do_compress(src, dst, args, verbose=not args.quiet)
                else:
                    do_convert(src, dst, args, verbose=not args.quiet)
                ok += 1
            except Exception as e:
                print(f"  error: {e}", file=sys.stderr)
                fail += 1

    print(f"done: {ok} ok, {fail} failed")

# --- argument parser ---------------------------------------------------------

def add_encode_args(p):
    g_vid = p.add_argument_group('video')
    g_vid.add_argument('--video-mode', dest='video_mode',
                       choices=['vbr', 'cbr'], default='vbr',
                       help='video bitrate mode: vbr=CRF, cbr=constant (default: vbr)')
    g_vid.add_argument('--crf',        type=int, default=21,
                       help='CRF quality [vbr] 0-51, lower=better (default: 21)')
    g_vid.add_argument('--video-bitrate', type=int, default=None,
                       dest='video_bitrate',
                       help='video bitrate in kbps [cbr], e.g. 1500')
    g_vid.add_argument('--preset',     default='slow',
                       choices=PRESETS,
                       help='x264 preset (default: slow)')
    g_vid.add_argument('--profile',    default='main',
                       choices=['baseline', 'main', 'high'],
                       help='H.264 profile (default: main — matches XviD4PSP/ME-tested '
                            'reference PMPs; baseline CAVLC hangs the real ME decoder)')
    g_vid.add_argument('--level',      default='3.0',
                       help='H.264 level, e.g. 1.3/2.1/3.0 (default: 1.3 for PSP)')
    g_vid.add_argument('--bframes',    type=int, default=0, choices=[0, 1, 2],
                       help='max B-frames (default: 0)')
    g_vid.add_argument('--deinterlace', action='store_true',
                       help='deinterlace source with yadif')
    g_vid.add_argument('--width',      type=int, default=None,
                       help=f'width (default: source, {DEF_W} for new encodes)')
    g_vid.add_argument('--height',     type=int, default=None,
                       help=f'height (default: source, {DEF_H} for new encodes)')
    g_vid.add_argument('--fps',        type=float, default=None,
                       help=f'output fps (max {FPS_MAX}; default: source fps)')
    g_vid.add_argument('--vbv-maxrate', type=int, default=10000,
                       dest='vbv_maxrate',
                       help='VBV maxrate kbps; with --nal-hrd vbr this drives the '
                            'HRD VUI + per-frame pic_timing SEIs. Default 10000 '
                            'matches XviD4PSP PMP output exactly (all reference '
                            'PMPs decode to vbv 10000/10000)')
    g_vid.add_argument('--vbv-bufsize', type=int, default=10000,
                       dest='vbv_bufsize',
                       help='VBV bufsize kbps; default 10000 matches XviD4PSP PMP output')
    g_vid.add_argument('--keyint',     type=int, default=250,
                       help='keyframe interval (default: 250)')
    g_vid.add_argument('--extra-x264', default='', dest='extra_x264',
                       help='extra x264 params, e.g. "me=hex:subme=7"')
    g_vid.add_argument('--x264-exe', default=None, dest='x264_exe',
                       help='path to a x264 binary for PSP reference SPS. '
                            'Native (non-.exe) builds are run directly with '
                            '--psp-compat; a .exe runs via wine (legacy). '
                            'Default: bundled bin/x264 when present.')

    g_aud = p.add_argument_group('audio')
    g_aud.add_argument('--audio-mode', dest='audio_mode',
                       choices=['vbr', 'cbr'], default='cbr',
                       help='audio bitrate mode: vbr=quality, cbr=constant (default: cbr)')
    g_aud.add_argument('--audio-bitrate', type=int, default=96,
                       dest='audio_bitrate',
                       help='audio bitrate kbps [cbr] (default: 96)')
    g_aud.add_argument('--audio-quality', type=float, default=2.0,
                       dest='audio_quality',
                       help='AAC VBR quality [vbr]: 0.1(best)...5.0(worst) (default: 2.0)')
    g_aud.add_argument('--audio-rate', type=int, default=44100,
                       dest='audio_rate', choices=[32000, 44100, 48000],
                       help='audio sample rate (default: 44100)')
    g_aud.add_argument('--audio-channels', default='stereo',
                       dest='audio_channels', choices=['mono', 'stereo'],
                       help='audio channels (default: stereo)')
    g_aud.add_argument('--no-audio',   action='store_true', dest='no_audio',
                       help='strip audio from output')

    p.add_argument('--stream',
                   choices=['video', 'audio', 'both'], default='both',
                   help='what to compress: video/audio/both (default: both)')

    p.add_argument('--suffix',     default='_compressed',
                   help='output filename suffix (default: _compressed)')
    p.add_argument('--keep-temp',  action='store_true', dest='keep_temp',
                   help='keep temporary folder')
    p.add_argument('-q', '--quiet', action='store_true',
                   help='quiet mode')


def build_parser():
    parser = argparse.ArgumentParser(
        prog='pmp-cli',
        description='PSP PMP converter / compressor',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  # VBR video (CRF) + CBR audio (defaults)
  pmp-cli convert video.mp4 out.pmp --crf 26 --audio-bitrate 96

  # CBR video + VBR audio
  pmp-cli convert video.mp4 out.pmp --video-mode cbr --video-bitrate 1500 \\
              --audio-mode vbr --audio-quality 1.5

  # force fps (max 25)
  pmp-cli convert video.mp4 out.pmp --fps 25

  # compress video only (keep audio)
  pmp-cli compress movie.pmp --stream video --crf 30 --preset fast

  # compress audio only (keep video)
  pmp-cli compress movie.pmp --stream audio --audio-mode vbr --audio-quality 3.0

  # batch: replace all .pmp recursively, video only
  pmp-cli batch ./pmps/ --batch-mode compress --recursive --replace --stream video

  # batch: convert all MP4 in folder
  pmp-cli batch ./videos/ --batch-mode convert --output-dir ./out/
"""
    )

    sub = parser.add_subparsers(dest='cmd')

    p_conv = sub.add_parser('convert', help='MP4/MKV/... -> PMP')
    p_conv.add_argument('input',  help='input video file')
    p_conv.add_argument('output', nargs='?', help='output .pmp (default: next to input)')
    add_encode_args(p_conv)

    p_comp = sub.add_parser('compress', help='PMP -> PMP (re-encode, smaller)')
    p_comp.add_argument('input',  help='input .pmp')
    p_comp.add_argument('output', nargs='?', help='output .pmp (default: <name>_compressed.pmp)')
    add_encode_args(p_comp)

    p_dec = sub.add_parser('decode', help='PMP -> MP4 (decode to playable file)')
    p_dec.add_argument('input',  help='input .pmp')
    p_dec.add_argument('output', nargs='?', help='output .mp4 (default: next to input)')
    g_vid = p_dec.add_argument_group('video')
    g_vid.add_argument('--crf',     type=int, default=21,
                       help='H.264 CRF quality 0-51, lower=better (default: 21)')
    g_vid.add_argument('--preset',  default='slow', choices=PRESETS,
                       help='H.264 x264 preset (default: slow)')
    g_vid.add_argument('--no-video', action='store_true', dest='no_video',
                       help='strip video from output')
    g_aud = p_dec.add_argument_group('audio')
    g_aud.add_argument('--audio-bitrate', type=int, default=192,
                       dest='audio_bitrate',
                       help='AAC bitrate kbps (default: 192)')
    g_aud.add_argument('--no-audio', action='store_true', dest='no_audio',
                       help='strip audio from output')
    p_dec.add_argument('-q', '--quiet', action='store_true',
                       help='quiet mode')
    p_dec.add_argument('--keep-temp', action='store_true', dest='keep_temp',
                       help='keep temporary folder (unused)')

    p_bat = sub.add_parser('batch', help='batch process files / directories')
    p_bat.add_argument('paths', nargs='+',
                       help='files and/or directories to process')
    p_bat.add_argument('--batch-mode', dest='batch_mode',
                       choices=['compress', 'convert'], default='compress',
                       help='compress (PMP->PMP) or convert (MP4->PMP) (default: compress)')
    p_bat.add_argument('-r', '--recursive', action='store_true',
                       help='recurse into subdirectories')
    p_bat.add_argument('--replace', action='store_true',
                       help='replace originals (atomic via temp)')
    p_bat.add_argument('--output-dir', dest='output_dir', default=None,
                       help='output folder (default: next to source)')
    p_bat.add_argument('--dry-run', action='store_true', dest='dry_run',
                       help='show what would be done, do nothing')
    add_encode_args(p_bat)

    return parser


def main():
    parser = build_parser()
    args   = parser.parse_args()

    if not args.cmd:
        parser.print_help()
        sys.exit(0)

    for dep in ('ffmpeg', 'ffprobe'):
        if shutil.which(dep) is None:
            die(f"{dep} not found in PATH")

    if args.cmd == 'convert':
        cmd_convert(args)
    elif args.cmd == 'compress':
        cmd_compress(args)
    elif args.cmd == 'decode':
        cmd_decode(args)
    elif args.cmd == 'batch':
        cmd_batch(args)


if __name__ == '__main__':
    main()
